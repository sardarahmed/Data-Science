v>\n</div>\n<script>(function(){\nvar I='tgypp0io',C=[\"name\"],R=[{\"name\":\"Ahmed\"},{\"name\":\"Ali\"},{\"name\":\"Sara\"},{\"name\":\"John\"},{\"name\":\"Maria\"},{\"name\":\"David\"}],P=10;\nvar NC=new Set([]);\nvar fil=R.slice(),sc=-1,sd=1,sh=P,wb=false,bb=false;\n\n// ── Pre-compute column stats (min, max, mean, std, nulls, distinct) ────────\nvar CMM={};\nC.forEach(function(c){\n  var all=R.map(function(r){return r[c];});\n  var nulls=all.filter(function(v){return v==null;}).length;\n  var distinct=new Set(all.filter(function(v){return v!=null;}).map(String)).size;\n  var base={total:R.length,nulls:nulls,distinct:distinct};\n  if(!NC.has(c)){CMM[c]=base;return;}\n  var vs=all.filter(function(v){return v!=null&&!isNaN(Number(v));}).map(Number);\n  if(!vs.length){CMM[c]=base;return;}\n  var mn=Math.min.apply(null,vs),mx=Math.max.apply(null,vs);\n  var sum=vs.reduce(function(a,b){return a+b;},0);\n  var mean=sum/vs.length;\n  var std=Math.sqrt(vs.reduce(function(a,v){return a+(v-mean)*(v-mean);},0)/vs.length);\n  CMM[c]=Object.assign(base,{mn:mn,mx:mx,mean:mean,std:std});\n});\n\nfunction xe(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');}\n\nfunction fmt(v){\n  if(v==null)return '<span class=\"NL\">null</span>';\n  return xe(String(v));\n}\n\nfunction copyText(t,cb){\n  if(navigator&&navigator.clipboard){navigator.clipboard.writeText(t).then(cb||function(){},function(){lc2(t);if(cb)cb();});}\n  else{lc2(t);if(cb)cb();}\n}\nfunction lc2(t){var el=document.createElement('textarea');el.value=t;el.style.cssText='position:fixed;opacity:0';document.body.appendChild(el);el.select();try{document.execCommand('copy');}catch(e){}el.remove();}\nfunction dl(content,mime,name){var a=document.createElement('a');a.href='data:'+mime+';charset=utf-8,'+encodeURIComponent(content);a.download=name;a.click();}\nfunction toast(msg){var t=document.createElement('div');t.style.cssText='position:fixed;bottom:20px;right:20px;