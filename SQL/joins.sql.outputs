t_id = products.product_id;","html":"<style>\n.R{font-family:var(--vscode-editor-font-family,monospace);font-size:12.5px;line-height:1.4}\n.TB{display:flex;gap:4px;align-items:center;margin-bottom:8px;flex-wrap:wrap}\n.TG{display:flex;align-items:center;background:var(--vscode-editorWidget-background);border:1px solid var(--vscode-panel-border);border-radius:4px;padding:1px;gap:0}\n.B{padding:3px 9px;font-size:11px;cursor:pointer;color:var(--vscode-foreground);background:transparent;border:none;border-radius:3px;white-space:nowrap;opacity:.85;transition:opacity .1s,background .1s}\n.B:hover{background:var(--vscode-list-hoverBackground);opacity:1}.B:active{transform:scale(.97)}\n.BD{width:1px;height:14px;background:var(--vscode-panel-border);margin:0 1px;align-self:center;flex-shrink:0}\n.F{padding:3px 8px;font-size:11px;background:var(--vscode-input-background);color:var(--vscode-input-foreground);border:1px solid var(--vscode-input-border,rgba(128,128,128,.3));border-radius:3px;width:175px;outline:none;transition:border-color .15s}\n.F:focus{border-color:var(--vscode-focusBorder)}\n.SC{overflow-x:auto;overflow-y:auto;max-height:380px;border:1px solid var(--vscode-panel-border);border-radius:4px}\n.R table{border-collapse:collapse;min-width:100%}\n.R thead{position:sticky;top:0;z-index:2}\n.R th{background:var(--vscode-editorGroupHeader-tabsBackground);color:var(--vscode-descriptionForeground);padding:5px 8px;text-align:left;border-bottom:2px solid var(--vscode-panel-border);border-right:1px solid var(--vscode-panel-border);white-space:nowrap;cursor:pointer;user-select:none;position:relative;font-size:10.5px;font-weight:600;letter-spacing:.04em;text-transform:uppercase}\n.R th:hover{background:var(--vscode-list-hoverBackground)}\n.R th.A::after{content:\" ▲\"}.R th.D::after{content:\" ▼\"}\n.RH{position:absolute;right:0;top:0;bottom:0;width:5px;cursor:col-resize;z-index:3}\n.RH:hover,.RH:active{background:var(--vscode-focusBorder);opacity:.5}\n.R td{padding:4px 8px;border-bottom:1px solid var(--vscode-panel-border);border-right:1px solid var(--vscode-panel-border);color:var(--vscode-editor-foreground);white-space:nowrap;max-width:320px;overflow:hidden;text-overflow:ellipsis;cursor:default;position:relative;vertical-align:middle;font-variant-numeric:tabular-nums}\n.R tr:nth-child(even) td{background:rgba(128,128,128,.04)}\n.R tr:hover td{background:var(--vscode-list-hoverBackground)!important}\n.R tr.HL td{background:var(--vscode-list-activeSelectionBackground)!important;color:var(--vscode-list-activeSelectionForeground)!important}\n.NL{color:var(--vscode-disabledForeground);font-style:italic;font-size:10px;background:rgba(128,128,128,.1);border-radius:2px;padding:0 3px}\n.NR{text-align:right}\n.DAB{position:absolute;left:0;top:1px;bottom:1px;opacity:.13;background:var(--vscode-charts-blue,#3794ff);pointer-events:none;border-radius:0 2px 2px 0}\n.WRP td{white-space:normal!important;word-break:break-word;max-width:none!important}\n.ST{position:fixed;background:var(--vscode-editorWidget-background);border:1px solid var(--vscode-panel-border);border-radius:5px;padding:10px 12px;font-size:11px;color:var(--vscode-editor-foreground);z-index:999;pointer-events:none;min-width:155px;line-height:2;max-width:240px}\n.SK{font-size:10px;color:var(--vscode-descriptionForeground);text-transform:uppercase;letter-spacing:.04em;font-weight:600;display:block;margin-bottom:2px}\n.MR{display:flex;align-items:center;gap:6px;margin-top:6px;font-size:11px;flex-wrap:wrap}\n.MC{color:var(--vscode-descriptionForeground)}.SL{color:var(--vscode-errorForeground)}\n.M{padding:8px 12px;border-radius:4px;font-size:12.5px}\n.MO{color:var(--vscode-terminal-ansiGreen)}.ME{color:var(--vscode-errorForeground);white-space:pre-wrap;font-family:monospace;display:block}\n.CH{margin-top:10px;overflow-x:auto}\n.CL{font-size:10px;fill:var(--vscode-editor-foreground)}.CV{font-size:9px;fill:var(--vscode-descriptionForeground)}\n</style><div class=\"R\" id=\"t32048g4_r\">\n<div class=\"TB\">\n  <input class=\"F\" placeholder=\"Search rows…\" oninput=\"sf_t32048g4(this.value)\" title=\"Filter all columns\"/>\n  <div class=\"TG\">\n    <button class=\"B\" onclick=\"se_t32048g4('csv')\"    title=\"Download all rows as CSV\">CSV</button>\n    <span class=\"BD\"></span>\n    <button class=\"B\" onclick=\"se_t32048g4('xls')\"    title=\"Download as Excel (.xls)\">XLS</button>\n    <span class=\"BD\"></span>\n    <button class=\"B\" onclick=\"se_t32048g4('copy')\"    title=\"Copy all rows as TSV to clipboard (paste into Sheets, Excel, etc.)\">Copy</button>\n  </div>\n  <div class=\"TG\">\n    <button class=\"B\" id=\"t32048g4_wb\" onclick=\"sw_t32048g4()\" title=\"Toggle text wrap\">Wrap</button>\n    <span class=\"BD\"></span>\n    <button class=\"B\" id=\"t32048g4_bb\" onclick=\"sb_t32048g4()\" title=\"Toggle data bars\">Bars</button>\n    <span class=\"BD\"></span><button class=\"B\" id=\"t32048g4_cb\" onclick=\"sc_t32048g4()\" title=\"Toggle chart\">Chart</button>\n  </div>\n</div>\n<div class=\"SC\"><table id=\"t32048g4_t\">\n  <thead><tr id=\"t32048g4_h\"><th onclick=\"ss_t32048g4(0)\" data-col=\"0\" class=\"\">name</th><th onclick=\"ss_t32048g4(1)\" data-col=\"1\" class=\"NR\">order_id</th><th onclick=\"ss_t32048g4(2)\" data-col=\"2\" class=\"\">product_name</th><th onclick=\"ss_t32048g4(3)\" data-col=\"3\" class=\"NR\">amount</th></tr></thead>\n  <tbody id=\"t32048g4_b\"></tbody>\n</table></div>\n<div id=\"t32048g4_f\"></div>\n<div id=\"t32048g4_ch\" class=\"CH\" hidden></div>\n</div>\n<script>(function(){\nvar I='t32048g4',C=[\"name\",\"order_id\",\"product_name\",\"amount\"],R=[{\"name\":\"Ahmed\",\"order_id\":101,\"product_name\":\"Laptop\",\"amount\":120},{\"name\":\"Ahmed\",\"order_id\":103,\"product_name\":\"Keyboard\",\"amount\":50},{\"name\":\"Ali\",\"order_id\":102,\"product_name\":\"Mouse\",\"amount\":80},{\"name\":\"Sara\",\"order_id\":104,\"product_name\":\"Laptop\",\"amount\":200},{\"name\":\"John\",\"order_id\":106,\"product_name\":\"Chair\",\"amount\":150}],P=10;\nvar NC=new Set([\"order_id\",\"amount\"]);\nvar fil=R.slice(),sc=-1,sd=1,sh=P,wb=false,bb=false;\n\n// ── Pre-compute column stats (min, max, mean, std, nulls, distinct) ────────\nvar CMM={};\nC.forEach(function(c){\n  var all=R.map(function(r){return r[c];});\n  var nulls=all.filter(function(v){return v==null;}).length;\n  var distinct=new Set(all.filter(function(v){return v!=null;}).map(String)).size;\n  var base={total:R.length,nulls:nulls,distinct:distinct};\n  if(!NC.has(c)){CMM[c]=base;return;}\n  var vs=all.filter(function(v){return v!=null&&!isNaN(Number(v));}).map(Number);\n  if(!vs.length){CMM[c]=base;return;}\n  var mn=Math.min.apply(null,vs),mx=Math.max.apply(null,vs);\n  var sum=vs.reduce(function(a,b){return a+b;},0);\n  var mean=sum/vs.length;\n  var std=Math.sqrt(vs.reduce(function(a,v){return a+(v-mean)*(v-mean);},0)/vs.length);\n  CMM[c]=Object.assign(base,{mn:mn,mx:mx,mean:mean,std:std});\n});\n\nfunction xe(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');}\n\nfunction fmt(v){\n  if(v==null)return '<span class=\"NL\">null</span>';\n  return xe(String(v));\n}\n\nfunction copyText(t,cb){\n  if(navigator&&navigator.clipboard){navigator.clipboard.writeText(t).then(cb||function(){},function(){lc2(t);if(cb)cb();});}\n  else{lc2(t);if(cb)cb();}\n}\nfunction lc2(t){var el=document.createElement('textarea');el.value=t;el.style.cssText='position:fixed;opacity:0';document.body.appendChild(el);el.select();try{document.execCommand('copy');}catch(e){}el.remove();}\nfunction dl(content,mime,name){var a=document.createElement('a');a.href='data:'+mime+';charset=utf-8,'+encodeURIComponent(content);a.download=name;a.click();}\nfunction toast(msg){var t=document.createElement('div');t.style.cssText='position:fixed;bottom:20px;right:20px;background:var(--vscode-editorWidget-background);border:1px solid var(--vscode-panel-border);border-radius:4px;padding:6px 12px;font-size:11px;z-index:9999;color:var(--vscode-editor-foreground);transition:opacity .3s';t.textContent=msg;document.body.appendChild(t);setTimeout(function(){t.style.opacity='0';setTimeout(function(){t.remove();},350);},1800);}\n\n\n// ── Core render ────────────────────────────────────────────────────────────\nfunction render(){\n  var tbody=document.getElementById(I+'_b');\n  tbody.innerHTML=fil.slice(0,sh).map(function(row){\n    return '<tr>'+C.map(function(c){\n      var v=row[c];\n      var bar='';\n      if(bb&&CMM[c]&&CMM[c].mn!=null){var mm=CMM[c];var rng=mm.mx-mm.mn;var pct=rng?Math.max(2,Math.round(100*(Number(v)-mm.mn)/rng)):50;bar='<div class=\"DAB\" style=\"width:'+pct+'%\"></div>';}\n      var raw=v==null?'':xe(String(v));\n      return '<td title=\"'+raw+'\" class=\"'+(NC.has(c)?'NR':'')+'\">'+bar+fmt(v)+'</td>';\n    }).join('')+'</tr>';\n  }).join('');\n\n  // Footer\n  var ms=0,tl='0ms';\n  var tc=ms>120000?'SL':'MC';\n  var shown=Math.min(sh,fil.length);\n  var st='Showing '+shown.toLocaleString()+' of '+fil.length.toLocaleString()+' rows';\n  if(5>fil.length)st+=' (5 fetched)';\n  var mb=fil.length>sh?'<button class=\"B\" style=\"padding:1px 8px;border:1px solid var(--vscode-panel-border);border-radius:3px;margin-left:2px\" onclick=\"sm_t32048g4()\">Show '+Math.min(P,fil.length-sh).toLocaleString()+' more ›</button>':'';\n  document.getElementById(I+'_f').innerHTML='<div class=\"MR\"><span class=\"MC\">'+st+'</span>'+mb+'<span class=\"'+tc+'\">&bull; '+tl+(ms>120000?' ⚠ slow':'')+'</span></div>';\n\n  // Sort indicators\n  document.getElementById(I+'_h').querySelectorAll('th').forEach(function(th,i){\n    var base=NC.has(C[i])?'NR':'';\n    th.className=base+(i===sc?(sd===1?' A':' D'):'');\n  });\n}\n\n// ── Actions ────────────────────────────────────────────────────────────────\nwindow['sm_'+I]=function(){sh+=P;render();};\n\nwindow['sf_'+I]=function(v){\n  v=v.toLowerCase();\n  fil=v?R.filter(function(r){return C.some(function(c){return String(r[c]==null?'':r[c]).toLowerCase().includes(v);});}):R.slice();\n  sh=P;render();\n};\n\nwindow['ss_'+I]=function(col){\n  if(sc===col){sd*=-1;}else{sc=col;sd=1;}\n  var k=C[col],isN=NC.has(k);\n  fil.sort(function(a,b){\n    var av=a[k],bv=b[k];\n    if(av==null)return sd;if(bv==null)return -sd;\n    return isN?(Number(av)-Number(bv))*sd:(String(av)<String(bv)?-sd:sd);\n  });\n  sh=P;render();\n};\n\nwindow['sw_'+I]=function(){wb=!wb;document.getElementById(I+'_t').classList.toggle('WRP',wb);document.getElementById(I+'_wb').style.opacity=wb?'1':'.85';};\nwindow['sb_'+I]=function(){bb=!bb;document.getElementById(I+'_bb').style.opacity=bb?'1':'.85';render();};\n\n// ── Export ─────────────────────────────────────────────────────────────────\nwindow['se_'+I]=function(fmt2){\n  if(fmt2==='csv'){\n    var lines=[C.join(',')].concat(R.map(function(r){return C.map(function(c){var v=r[c]==null?'':String(r[c]);return(v.includes(',')||v.includes('\"')||v.includes('\\n'))?'\"'+v.replace(/\"/g,'\"\"')+'\"':v;}).join(',');}));\n    dl(lines.join('\\n'),'text/csv','query_result.csv');\n  } else if(fmt2==='xls'){\n    var xh='<?xml version=\"1.0\"?><Workbook xmlns=\"urn:schemas-microsoft-com:office:spreadsheet\" xmlns:ss=\"urn:schemas-microsoft-com:office:spreadsheet\"><Worksheet ss:Name=\"Results\"><Table>';\n    xh+='<Row>'+C.map(function(c){return '<Cell><Data ss:Type=\"String\">'+xe(c)+'</Data></Cell>';}).join('')+'</Row>';\n    R.forEach(function(r){xh+='<Row>'+C.map(function(c){var v=r[c];if(v==null)return '<Cell><Data ss:Type=\"String\"></Data></Cell>';var n=Number(v);if(!isNaN(n)&&v!=='')return '<Cell><Data ss:Type=\"Number\">'+n+'</Data></Cell>';return '<Cell><Data ss:Type=\"String\">'+xe(String(v))+'</Data></Cell>';}).join('')+'</Row>';});\n    dl(xh+'</Table></Worksheet></Workbook>','application/vnd.ms-excel','query_result.xls');\n  } else if(fmt2==='copy'){\n    var tsv=[C.join('\\t')].concat(R.map(function(r){return C.map(function(c){return r[c]==null?'':String(r[c]).replace(/\\t/g,' ').replace(/\\n/g,' ');}).join('\\t');})).join('\\n');\n    copyText(tsv,function(){toast('Copied '+R.length.toLocaleString()+' rows — paste into Sheets, Excel, etc.');});\n  }\n};\n\n// ── Shift+click row highlight ─────────────────────────────────────────────\ndocument.getElementById(I+'_b').addEventListener('click',function(e){\n  if(!e.shiftKey)return;\n  var td=e.target.closest('td');if(!td)return;\n  td.parentElement.classList.toggle('HL');\n});\n\n// ── Column stats tooltip (uses pre-computed CMM) ──────────────────────────\n(function(){\n  var tip=null;\n  document.getElementById(I+'_h').querySelectorAll('th').forEach(function(th,i){\n    var col=C[i];if(!col)return;\n    th.addEventListener('mouseenter',function(ev){\n      if(ev.relatedTarget&&th.contains(ev.relatedTarget))return;\n      if(!tip){tip=document.createElement('div');tip.className='ST';document.body.appendChild(tip);}\n      var m=CMM[col]||{};\n      var out='<span class=\"SK\">'+xe(col)+'</span>';\n      if(m.total!=null){\n        out+='Rows: '+m.total.toLocaleString()+'<br>';\n        out+='Nulls: '+m.nulls+(m.total?' ('+Math.round(100*m.nulls/m.total)+'%)':'')+'<br>';\n        out+='Distinct: '+m.distinct.toLocaleString()+'<br>';\n        if(m.mn!=null)out+='Min: '+m.mn.toLocaleString()+'<br>Max: '+m.mx.toLocaleString()+'<br>Avg: '+m.mean.toLocaleString(undefined,{maximumFractionDigits:2})+'<br>';\n      }\n      tip.innerHTML=out;\n      var r=th.getBoundingClientRect();tip.style.display='block';\n      tip.style.left=Math.min(r.left,window.innerWidth-180)+'px';tip.style.top=(r.bottom+5)+'px';\n    });\n    th.addEventListener('mouseleave',function(ev){if(tip&&!tip.contains(ev.relatedTarget))tip.style.display='none';});\n  });\n})();\n\n// ── Column resize ─────────────────────────────────────────────────────────\n(function(){\n  document.getElementById(I+'_h').querySelectorAll('th').forEach(function(th){\n    var rh=document.createElement('div');rh.className='RH';\n    rh.addEventListener('mousedown',function(e){\n      var rx=e.clientX,rw=th.offsetWidth;\n      var mv=function(e2){var w=Math.max(40,rw+(e2.clientX-rx));th.style.width=w+'px';th.style.minWidth=w+'px';};\n      var up=function(){document.removeEventListener('mousemove',mv);document.removeEventListener('mouseup',up);};\n      document.addEventListener('mousemove',mv);document.addEventListener('mouseup',up);\n      e.stopPropagation();e.preventDefault();\n    });\n    th.appendChild(rh);\n  });\n})();\n\n// ── Chart: line/area for time-series, bar for everything else ─────────────\n\nwindow['sc_'+I]=function(){\n  var el=document.getElementById(I+'_ch');\n  if(!el.hidden){el.hidden=true;return;}\n  el.hidden=false;\n  var isTS=false;\n  var lc='name',vc='order_id';\n  var cd=fil.slice(0,60);\n  var vs=cd.map(function(r){return Number(r[vc])||0;});\n  var mx=Math.max.apply(null,vs)||1;\n  var mn2=Math.min.apply(null,vs.filter(function(v){return v>0;}))||0;\n  var W=520,H=180,padL=60,padB=28,padT=16,iW=W-padL,iH=H-padB-padT;\n  if(isTS){\n    // ── Line / area chart ────────────────────────────────────────────────\n    var span=mx-mn2||1;\n    var pts=cd.map(function(r,i){\n      var x=padL+Math.round(i*(iW-1)/(Math.max(cd.length-1,1)));\n      var y=padT+Math.round(iH-(Number(r[vc])||0-mn2)/span*iH);\n      return x+','+y;\n    });\n    var areaPath='M'+padL+','+(padT+iH)+' L'+pts.join(' L')+' L'+(padL+iW)+','+(padT+iH)+' Z';\n    var dots=cd.map(function(r,i){\n      var x=padL+Math.round(i*(iW-1)/(Math.max(cd.length-1,1)));\n      var y=padT+Math.round(iH-(Number(r[vc])||0-mn2)/span*iH);\n      var lb=xe(String(r[lc]||'').slice(0,10));\n      var v2=(Number(r[vc])||0).toLocaleString();\n      return '<circle cx=\"'+x+'\" cy=\"'+y+'\" r=\"3\" fill=\"var(--vscode-charts-blue,#3794ff)\" opacity=\".9\">'+\n        '<title>'+lb+': '+v2+'</title></circle>';\n    }).join('');\n    // X axis labels (every Nth label to avoid crowding)\n    var step=Math.ceil(cd.length/8);\n    var xlabels=cd.filter(function(_,i){return i%step===0||i===cd.length-1;}).map(function(r,idx,arr){\n      var origIdx=idx===arr.length-1?cd.length-1:idx*step;\n      var x=padL+Math.round(origIdx*(iW-1)/(Math.max(cd.length-1,1)));\n      return '<text class=\"CV\" x=\"'+x+'\" y=\"'+(H-6)+'\" text-anchor=\"middle\">'+xe(String(r[lc]||'').slice(0,10))+'</text>';\n    }).join('');\n    el.innerHTML='<svg width=\"'+W+'\" height=\"'+H+'\" style=\"overflow:visible\">'+\n      '<defs><linearGradient id=\"ag'+I+'\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0%\" stop-color=\"var(--vscode-charts-blue,#3794ff)\" stop-opacity=\".25\"/><stop offset=\"100%\" stop-color=\"var(--vscode-charts-blue,#3794ff)\" stop-opacity=\".02\"/></linearGradient></defs>'+\n      '<path d=\"'+areaPath+'\" fill=\"url(#ag'+I+')\" />'+\n      '<polyline points=\"'+pts.join(' ')+'\" fill=\"none\" stroke=\"var(--vscode-charts-blue,#3794ff)\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>'+\n      dots+xlabels+\n      '<text class=\"CL\" x=\"'+(padL-8)+'\" y=\"'+(padT)+'\" text-anchor=\"end\">'+xe(vc)+'</text>'+\n      '<line x1=\"'+padL+'\" y1=\"'+padT+'\" x2=\"'+padL+'\" y2=\"'+(padT+iH)+'\" stroke=\"var(--vscode-panel-border)\" stroke-width=\"1\"/>'+\n      '<line x1=\"'+padL+'\" y1=\"'+(padT+iH)+'\" x2=\"'+(padL+iW)+'\" y2=\"'+(padT+iH)+'\" stroke=\"var(--vscode-panel-border)\" stroke-width=\"1\"/>'+\n      '</svg>';\n  } else {\n    // ── Bar chart ────────────────────────────────────────────────────────\n    var bw=Math.max(6,Math.floor(iW/Math.max(cd.length,1))-2);\n    var bars=cd.map(function(r,i){\n      var v2=Number(r[vc])||0;var bh=Math.max(1,Math.round((v2/mx)*iH));\n      var x=padL+i*(bw+2);var y=padT+iH-bh;\n      var lb=xe(String(r[lc]||'').slice(0,8));\n      return '<rect x=\"'+x+'\" y=\"'+y+'\" width=\"'+bw+'\" height=\"'+bh+'\" fill=\"var(--vscode-charts-blue,#3794ff)\" rx=\"1\"/>'+\n        '<text class=\"CV\" x=\"'+(x+bw/2)+'\" y=\"'+(y-2)+'\" text-anchor=\"middle\">'+v2.toLocaleString()+'</text>'+\n        '<text class=\"CV\" x=\"'+(x+bw/2)+'\" y=\"'+(padT+iH+12)+'\" text-anchor=\"middle\">'+lb+'</text>';\n    }).join('');\n    el.innerHTML='<svg width=\"'+W+'\" height=\"'+H+'\" style=\"overflow:visible\">'+\n      '<text class=\"CL\" x=\"'+(padL-10)+'\" y=\"'+(padT+iH/2)+'\" transform=\"rotate(-90,'+(padL-10)+','+(padT+iH/2)+')\" text-anchor=\"middle\">'+xe(vc)+'</text>'+\n      bars+\n      '<line x1=\"'+padL+'\" y1=\"'+padT+'\" x2=\"'+padL+'\" y2=\"'+(padT+iH)+'\" stroke=\"var(--vscode-panel-border)\" stroke-width=\"1\"/>'+\n      '<line x1=\"'+padL+'\" y1=\"'+(padT+iH)+'\" x2=\"'+(padL+iW)+'\" y2=\"'+(padT+iH)+'\" stroke=\"var(--vscode-panel-border)\" stroke-width=\"1\"/>'+\n      '</svg>';\n  }\n};\n\nrender();\n})();</script>","stale":false,"executedAt":1790628508060,"columns":["name","order_id","product_name","amount"],"rowCount":5},"18":{"sql":"SELECT\n    name,\n    order_id,\n    amount\nFROM\n    customers\n    LEFT JOIN orders ON customers.customer_id = orders.customer_id;","html":"<style>\n.R{font-family:var(--vscode-editor-font-family,monospace);font-size:12.5px;line-height:1.4}\n.TB{display:flex;gap:4px;align-items:center;margin-bottom:8px;flex-wrap:wrap}\n.TG{display:flex;align-items:center;background:var(--vscode-editorWidget-background);border:1px solid var(--vscode-panel-border);border-radius:4px;padding:1px;gap:0}\n.B{padding:3px 9px;font-size:11px;cursor:pointer;color:var(--vscode-foreground);background:transparent;border:none;border-radius:3px;white-space:nowrap;opacity:.85;transition:opacity .1s,background .1s}\n.B:hover{background:var(--vscode-list-hoverBackground);opacity:1}.B:active{transform:scale(.97)}\n.BD{width:1px;height:14px;background:var(--vscode-panel-border);margin:0 1px;align-self:center;flex-shrink:0}\n.F{padding:3px 8px;font-size:11px;background:var(--vscode-input-background);color:var(--vscode-input-foreground);border:1px solid var(--vscode-input-border,rgba(128,128,128,.3));border-radius:3px;width:175px;outline:none;transition:border-color .15s}\n.F:focus{border-color:var(--vscode-focusBorder)}\n.SC{overflow-x:auto;overflow-y:auto;max-height:380px;border:1px solid var(--vscode-panel-border);border-radius:4px}\n.R table{border-collapse:collapse;min-width:100%}\n.R thead{position:sticky;top:0;z-index:2}\n.R th{background:var(--vscode-editorGroupHeader-tabsBackground);color:var(--vscode-descriptionForeground);padding:5px 8px;text-align:left;border-bottom:2px solid var(--vscode-panel-border);border-right:1px solid var(--vscode-panel-border);white-space:nowrap;cursor:pointer;user-select:none;position:relative;font-size:10.5px;font-weight:600;letter-spacing:.04em;text-transform:uppercase}\n.R th:hover{background:var(--vscode-list-hoverBackground)}\n.R th.A::after{content:\" ▲\"}.R th.D::after{content:\" ▼\"}\n.RH{position:absolute;right:0;top:0;bottom:0;width:5px;cursor:col-resize;z-index:3}\n.RH:hover,.RH:active{background:var(--vscode-focusBorder);opacity:.5}\n.R td{padding:4px 8px;border-bottom:1px solid var(--vscode-panel-border);border-right:1px solid var(--vscode-panel-border);color:var(--vscode-editor-foreground);white-space:nowrap;max-width:320px;overflow:hidden;text-overflow:ellipsis;cursor:default;position:relative;vertical-align:middle;font-variant-numeric:tabular-nums}\n.R tr:nth-child(even) td{background:rgba(128,128,128,.04)}\n.R tr:hover td{background:var(--vscode-list-hoverBackground)!important}\n.R tr.HL td{background:var(--vscode-list-activeSelectionBackground)!important;color:var(--vscode-list-activeSelectionForeground)!important}\n.NL{color:var(--vscode-disabledForeground);font-style:italic;font-size:10px;background:rgba(128,128,128,.1);border-radius:2px;padding:0 3px}\n.NR{text-align:right}\n.DAB{position:absolute;left:0;top:1px;bottom:1px;opacity:.13;background:var(--vscode-charts-blue,#3794ff);pointer-events:none;border-radius:0 2px 2px 0}\n.WRP td{white-space:normal!important;word-break:break-word;max-width:none!important}\n.ST{position:fixed;background:var(--vscode-editorWidget-background);border:1px solid var(--vscode-panel-border);border-radius:5px;padding:10px 12px;font-size:11px;color:var(--vscode-editor-foreground);z-index:999;pointer-events:none;min-width:155px;line-height:2;max-width:240px}\n.SK{font-size:10px;color:var(--vscode-descriptionForeground);text-transform:uppercase;letter-spacing:.04em;font-weight:600;display:block;margin-bottom:2px}\n.MR{display:flex;align-items:center;gap:6px;margin-top:6px;font-size:11px;flex-wrap:wrap}\n.MC{color:var(--vscode-descriptionForeground)}.SL{color:var(--vscode-errorForeground)}\n.M{padding:8px 12px;border-radius:4px;font-size:12.5px}\n.MO{color:var(--vscode-terminal-ansiGreen)}.ME{color:var(--vscode-errorForeground);white-space:pre-wrap;font-family:monospace;display:block}\n.CH{margin-top:10px;overflow-x:auto}\n.CL{font-size:10px;fill:var(--vscode-editor-foreground)}.CV{font-size:9px;fill:var(--vscode-descriptionForeground)}\n</style><div class=\"R\" id=\"tp8ezang_r\">\n<div class=\"TB\">\n  <input class=\"F\" placeholder=\"Search rows…\" oninput=\"sf_tp8ezang(this.value)\" title=\"Filter all columns\"/>\n  <div class=\"TG\">\n    <button class=\"B\" onclick=\"se_tp8ezang('csv')\"    title=\"Download all rows as CSV\">CSV</button>\n    <span class=\"BD\"></span>\n    <button class=\"B\" onclick=\"se_tp8ezang('xls')\"    title=\"Download as Excel (.xls)\">XLS</button>\n    <span class=\"BD\"></span>\n    <button class=\"B\" onclick=\"se_tp8ezang('copy')\"    title=\"Copy all rows as TSV to clipboard (paste into Sheets, Excel, etc.)\">Copy</button>\n  </div>\n  <div class=\"TG\">\n    <button class=\"B\" id=\"tp8ezang_wb\" onclick=\"sw_tp8ezang()\" title=\"Toggle text wrap\">Wrap</button>\n    <span class=\"BD\"></span>\n    <button class=\"B\" id=\"tp8ezang_bb\" onclick=\"sb_tp8ezang()\" title=\"Toggle data bars\">Bars</button>\n    <span class=\"BD\"></span><button class=\"B\" id=\"tp8ezang_cb\" onclick=\"sc_tp8ezang()\" title=\"Toggle chart\">Chart</button>\n  </div>\n</div>\n<div class=\"SC\"><table id=\"tp8ezang_t\">\n  <thead><tr id=\"tp8ezang_h\"><th onclick=\"ss_tp8ezang(0)\" data-col=\"0\" class=\"\">name</th><th onclick=\"ss_tp8ezang(1)\" data-col=\"1\" class=\"NR\">order_id</th><th onclick=\"ss_tp8ezang(2)\" data-col=\"2\" class=\"NR\">amount</th></tr></thead>\n  <tbody id=\"tp8ezang_b\"></tbody>\n</table></div>\n<div id=\"tp8ezang_f\"></div>\n<div id=\"tp8ezang_ch\" class=\"CH\" hidden></div>\n</div>\n<script>(function(){\nvar I='tp8ezang',C=[\"name\",\"order_id\",\"amount\"],R=[{\"name\":\"Ahmed\",\"order_id\":101,\"amount\":120},{\"name\":\"Ahmed\",\"order_id\":103,\"amount\":50},{\"name\":\"Ali\",\"order_id\":102,\"amount\":80},{\"name\":\"Sara\",\"order_id\":104,\"amount\":200},{\"name\":\"John\",\"order_id\":106,\"amount\":150},{\"name\":\"Maria\",\"order_id\":null,\"amount\":null},{\"name\":\"David\",\"order_id\":null,\"amount\":null}],P=10;\nvar NC=new Set([\"order_id\",\"amount\"]);\nvar fil=R.slice(),sc=-1,sd=1,sh=P,wb=false,bb=false;\n\n// ── Pre-compute column stats (min, max, mean, std, nulls, distinct) ────────\nvar CMM={};\nC.forEach(function(c){\n  var all=R.map(function(r){return r[c];});\n  var nulls=all.filter(function(v){return v==null;}).length;\n  var distinct=new Set(all.filter(function(v){return v!=null;}).map(String)).size;\n  var base={total:R.length,nulls:nulls,distinct:distinct};\n  if(!NC.has(c)){CMM[c]=base;return;}\n  var vs=all.filter(function(v){return v!=null&&!isNaN(Number(v));}).map(Number);\n  if(!vs.length){CMM[c]=base;return;}\n  var mn=Math.min.apply(null,vs),mx=Math.max.apply(null,vs);\n  var sum=vs.reduce(function(a,b){return a+b;},0);\n  var mean=sum/vs.length;\n  var std=Math.sqrt(vs.reduce(function(a,v){return a+(v-mean)*(v-mean);},0)/vs.length);\n  CMM[c]=Object.assign(base,{mn:mn,mx:mx,mean:mean,std:std});\n});\n\nfunction xe(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');}\n\nfunction fmt(v){\n  if(v==null)return '<span class=\"NL\">null</span>';\n  return xe(String(v));\n}\n\nfunction copyText(t,cb){\n  if(navigator&&navigator.clipboard){navigator.clipboard.writeText(t).then(cb||function(){},function(){lc2(t);if(cb)cb();});}\n  else{lc2(t);if(cb)cb();}\n}\nfunction lc2(t){var el=document.createElement('textarea');el.value=t;el.style.cssText='position:fixed;opacity:0';document.body.appendChild(el);el.select();try{document.execCommand('copy');}catch(e){}el.remove();}\nfunction dl(content,mime,name){var a=document.createElement('a');a.href='data:'+mime+';charset=utf-8,'+encodeURIComponent(content);a.download=name;a.click();}\nfunction toast(msg){var t=document.createElement('div');t.style.cssText='position:fixed;bottom:20px;right:20px;background:var(--vscode-editorWidget-background);border:1px solid var(--vscode-panel-border);border-radius:4px;padding:6px 12px;font-size:11px;z-index:9999;color:var(--vscode-editor-foreground);transition:opacity .3s';t.textContent=msg;document.body.appendChild(t);setTimeout(function(){t.style.opacity='0';setTimeout(function(){t.remove();},350);},1800);}\n\n\n// ── Core render ────────────────────────────────────────────────────────────\nfunction render(){\n  var tbody=document.getElementById(I+'_b');\n  tbody.innerHTML=fil.slice(0,sh).map(function(row){\n    return '<tr>'+C.map(function(c){\n      var v=row[c];\n      var bar='';\n      if(bb&&CMM[c]&&CMM[c].mn!=null){var mm=CMM[c];var rng=mm.mx-mm.mn;var pct=rng?Math.max(2,Math.round(100*(Number(v)-mm.mn)/rng)):50;bar='<div class=\"DAB\" style=\"width:'+pct+'%\"></div>';}\n      var raw=v==null?'':xe(String(v));\n      return '<td title=\"'+raw+'\" class=\"'+(NC.has(c)?'NR':'')+'\">'+bar+fmt(v)+'</td>';\n    }).join('')+'</tr>';\n  }).join('');\n\n  // Footer\n  var ms=0,tl='0ms';\n  var tc=ms>120000?'SL':'MC';\n  var shown=Math.min(sh,fil.length);\n  var st='Showing '+shown.toLocaleString()+' of '+fil.length.toLocaleString()+' rows';\n  if(7>fil.length)st+=' (7 fetched)';\n  var mb=fil.length>sh?'<button class=\"B\" style=\"padding:1px 8px;border:1px solid var(--vscode-panel-border);border-radius:3px;margin-left:2px\" onclick=\"sm_tp8ezang()\">Show '+Math.min(P,fil.length-sh).toLocaleString()+' more ›</button>':'';\n  document.getElementById(I+'_f').innerHTML='<div class=\"MR\"><span class=\"MC\">'+st+'</span>'+mb+'<span class=\"'+tc+'\">&bull; '+tl+(ms>120000?' ⚠ slow':'')+'</span></div>';\n\n  // Sort indicators\n  document.getElementById(I+'_h').querySelectorAll('th').forEach(function(th,i){\n    var base=NC.has(C[i])?'NR':'';\n    th.className=base+(i===sc?(sd===1?' A':' D'):'');\n  });\n}\n\n// ── Actions ────────────────────────────────────────────────────────────────\nwindow['sm_'+I]=function(){sh+=P;render();};\n\nwindow['sf_'+I]=function(v){\n  v=v.toLowerCase();\n  fil=v?R.filter(function(r){return C.some(function(c){return String(r[c]==null?'':r[c]).toLowerCase().includes(v);});}):R.slice();\n  sh=P;render();\n};\n\nwindow['ss_'+I]=function(col){\n  if(sc===col){sd*=-1;}else{sc=col;sd=1;}\n  var k=C[col],isN=NC.has(k);\n  fil.sort(function(a,b){\n    var av=a[k],bv=b[k];\n    if(av==null)return sd;if(bv==null)return -sd;\n    return isN?(Number(av)-Number(bv))*sd:(String(av)<String(bv)?-sd:sd);\n  });\n  sh=P;render();\n};\n\nwindow['sw_'+I]=function(){wb=!wb;document.getElementById(I+'_t').classList.toggle('WRP',wb);document.getElementById(I+'_wb').style.opacity=wb?'1':'.85';};\nwindow['sb_'+I]=function(){bb=!bb;document.getElementById(I+'_bb').style.opacity=bb?'1':'.85';render();};\n\n// ── Export ─────────────────────────────────────────────────────────────────\nwindow['se_'+I]=function(fmt2){\n  if(fmt2==='csv'){\n    var lines=[C.join(',')].concat(R.map(function(r){return C.map(function(c){var v=r[c]==null?'':String(r[c]);return(v.includes(',')||v.includes('\"')||v.includes('\\n'))?'\"'+v.replace(/\"/g,'\"\"')+'\"':v;}).join(',');}));\n    dl(lines.join('\\n'),'text/csv','query_result.csv');\n  } else if(fmt2==='xls'){\n    var xh='<?xml version=\"1.0\"?><Workbook xmlns=\"urn:schemas-microsoft-com:office:spreadsheet\" xmlns:ss=\"urn:schemas-microsoft-com:office:spreadsheet\"><Worksheet ss:Name=\"Results\"><Table>';\n    xh+='<Row>'+C.map(function(c){return '<Cell><Data ss:Type=\"String\">'+xe(c)+'</Data></Cell>';}).join('')+'</Row>';\n    R.forEach(function(r){xh+='<Row>'+C.map(function(c){var v=r[c];if(v==null)return '<Cell><Data ss:Type=\"String\"></Data></Cell>';var n=Number(v);if(!isNaN(n)&&v!=='')return '<Cell><Data ss:Type=\"Number\">'+n+'</Data></Cell>';return '<Cell><Data ss:Type=\"String\">'+xe(String(v))+'</Data></Cell>';}).join('')+'</Row>';});\n    dl(xh+'</Table></Worksheet></Workbook>','application/vnd.ms-excel','query_result.xls');\n  } else if(fmt2==='copy'){\n    var tsv=[C.join('\\t')].concat(R.map(function(r){return C.map(function(c){return r[c]==null?'':String(r[c]).replace(/\\t/g,' ').replace(/\\n/g,' ');}).join('\\t');})).join('\\n');\n    copyText(tsv,function(){toast('Copied '+R.length.toLocaleString()+' rows — paste into Sheets, Excel, etc.');});\n  }\n};\n\n// ── Shift+click row highlight ─────────────────────────────────────────────\ndocument.getElementById(I+'_b').addEventListener('click',function(e){\n  if(!e.shiftKey)return;\n  var td=e.target.closest('td');if(!td)return;\n  td.parentElement.classList.toggle('HL');\n});\n\n// ── Column stats tooltip (uses pre-computed CMM) ──────────────────────────\n(function(){\n  var tip=null;\n  document.getElementById(I+'_h').querySelectorAll('th').forEach(function(th,i){\n    var col=C[i];if(!col)return;\n    th.addEventListener('mouseenter',function(ev){\n      if(ev.relatedTarget&&th.contains(ev.relatedTarget))return;\n      if(!tip){tip=document.createElement('div');tip.className='ST';document.body.appendChild(tip);}\n      var m=CMM[col]||{};\n      var out='<span class=\"SK\">'+xe(col)+'</span>';\n      if(m.total!=null){\n        out+='Rows: '+m.total.toLocaleString()+'<br>';\n        out+='Nulls: '+m.nulls+(m.total?' ('+Math.round(100*m.nulls/m.total)+'%)':'')+'<br>';\n        out+='Distinct: '+m.distinct.toLocaleString()+'<br>';\n        if(m.mn!=null)out+='Min: '+m.mn.toLocaleString()+'<br>Max: '+m.mx.toLocaleString()+'<br>Avg: '+m.mean.toLocaleString(undefined,{maximumFractionDigits:2})+'<br>';\n      }\n      tip.innerHTML=out;\n      var r=th.getBoundingClientRect();tip.style.display='block';\n      tip.style.left=Math.min(r.left,window.innerWidth-180)+'px';tip.style.top=(r.bottom+5)+'px';\n    });\n    th.addEventListener('mouseleave',function(ev){if(tip&&!tip.contains(ev.relatedTarget))tip.style.display='none';});\n  });\n})();\n\n// ── Column resize ─────────────────────────────────────────────────────────\n(function(){\n  document.getElementById(I+'_h').querySelectorAll('th').forEach(function(th){\n    var rh=document.createElement('div');rh.className='RH';\n    rh.addEventListener('mousedown',function(e){\n      var rx=e.clientX,rw=th.offsetWidth;\n      var mv=function(e2){var w=Math.max(40,rw+(e2.clientX-rx));th.style.width=w+'px';th.style.minWidth=w+'px';};\n      var up=function(){document.removeEventListener('mousemove',mv);document.removeEventListener('mouseup',up);};\n      document.addEventListener('mousemove',mv);document.addEventListener('mouseup',up);\n      e.stopPropagation();e.preventDefault();\n    });\n    th.appendChild(rh);\n  });\n})();\n\n// ── Chart: line/area for time-series, bar for everything else ─────────────\n\nwindow['sc_'+I]=function(){\n  var el=document.getElementById(I+'_ch');\n  if(!el.hidden){el.hidden=true;return;}\n  el.hidden=false;\n  var isTS=false;\n  var lc='name',vc='order_id';\n  var cd=fil.slice(0,60);\n  var vs=cd.map(function(r){return Number(r[vc])||0;});\n  var mx=Math.max.apply(null,vs)||1;\n  var mn2=Math.min.apply(null,vs.filter(function(v){return v>0;}))||0;\n  var W=520,H=180,padL=60,padB=28,padT=16,iW=W-padL,iH=H-padB-padT;\n  if(isTS){\n    // ── Line / area chart ────────────────────────────────────────────────\n    var span=mx-mn2||1;\n    var pts=cd.map(function(r,i){\n      var x=padL+Math.round(i*(iW-1)/(Math.max(cd.length-1,1)));\n      var y=padT+Math.round(iH-(Number(r[vc])||0-mn2)/span*iH);\n      return x+','+y;\n    });\n    var areaPath='M'+padL+','+(padT+iH)+' L'+pts.join(' L')+' L'+(padL+iW)+','+(padT+iH)+' Z';\n    var dots=cd.map(function(r,i){\n      var x=padL+Math.round(i*(iW-1)/(Math.max(cd.length-1,1)));\n      var y=padT+Math.round(iH-(Number(r[vc])||0-mn2)/span*iH);\n      var lb=xe(String(r[lc]||'').slice(0,10));\n      var v2=(Number(r[vc])||0).toLocaleString();\n      return '<circle cx=\"'+x+'\" cy=\"'+y+'\" r=\"3\" fill=\"var(--vscode-charts-blue,#3794ff)\" opacity=\".9\">'+\n        '<title>'+lb+': '+v2+'</title></circle>';\n    }).join('');\n    // X axis labels (every Nth label to avoid crowding)\n    var step=Math.ceil(cd.length/8);\n    var xlabels=cd.filter(function(_,i){return i%step===0||i===cd.length-1;}).map(function(r,idx,arr){\n      var origIdx=idx===arr.length-1?cd.length-1:idx*step;\n      var x=padL+Math.round(origIdx*(iW-1)/(Math.max(cd.length-1,1)));\n      return '<text class=\"CV\" x=\"'+x+'\" y=\"'+(H-6)+'\" text-anchor=\"middle\">'+xe(String(r[lc]||'').slice(0,10))+'</text>';\n    }).join('');\n    el.innerHTML='<svg width=\"'+W+'\" height=\"'+H+'\" style=\"overflow:visible\">'+\n      '<defs><linearGradient id=\"ag'+I+'\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0%\" stop-color=\"var(--vscode-charts-blue,#3794ff)\" stop-opacity=\".25\"/><stop offset=\"100%\" stop-color=\"var(--vscode-charts-blue,#3794ff)\" stop-opacity=\".02\"/></linearGradient></defs>'+\n      '<path d=\"'+areaPath+'\" fill=\"url(#ag'+I+')\" />'+\n      '<polyline points=\"'+pts.join(' ')+'\" fill=\"none\" stroke=\"var(--vscode-charts-blue,#3794ff)\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>'+\n      dots+xlabels+\n      '<text class=\"CL\" x=\"'+(padL-8)+'\" y=\"'+(padT)+'\" text-anchor=\"end\">'+xe(vc)+'</text>'+\n      '<line x1=\"'+padL+'\" y1=\"'+padT+'\" x2=\"'+padL+'\" y2=\"'+(padT+iH)+'\" stroke=\"var(--vscode-panel-border)\" stroke-width=\"1\"/>'+\n      '<line x1=\"'+padL+'\" y1=\"'+(padT+iH)+'\" x2=\"'+(padL+iW)+'\" y2=\"'+(padT+iH)+'\" stroke=\"var(--vscode-panel-border)\" stroke-width=\"1\"/>'+\n      '</svg>';\n  } else {\n    // ── Bar chart ────────────────────────────────────────────────────────\n    var bw=Math.max(6,Math.floor(iW/Math.max(cd.length,1))-2);\n    var bars=cd.map(function(r,i){\n      var v2=Number(r[vc])||0;var bh=Math.max(1,Math.round((v2/mx)*iH));\n      var x=padL+i*(bw+2);var y=padT+iH-bh;\n      var lb=xe(String(r[lc]||'').slice(0,8));\n      return '<rect x=\"'+x+'\" y=\"'+y+'\" width=\"'+bw+'\" height=\"'+bh+'\" fill=\"var(--vscode-charts-blue,#3794ff)\" rx=\"1\"/>'+\n        '<text class=\"CV\" x=\"'+(x+bw/2)+'\" y=\"'+(y-2)+'\" text-anchor=\"middle\">'+v2.toLocaleString()+'</text>'+\n        '<text class=\"CV\" x=\"'+(x+bw/2)+'\" y=\"'+(padT+iH+12)+'\" text-anchor=\"middle\">'+lb+'</text>';\n    }).join('');\n    el.innerHTML='<svg width=\"'+W+'\" height=\"'+H+'\" style=\"overflow:visible\">'+\n      '<text class=\"CL\" x=\"'+(padL-10)+'\" y=\"'+(padT+iH/2)+'\" transform=\"rotate(-90,'+(padL-10)+','+(padT+iH/2)+')\" text-anchor=\"middle\">'+xe(vc)+'</text>'+\n      bars+\n      '<line x1=\"'+padL+'\" y1=\"'+padT+'\" x2=\"'+padL+'\" y2=\"'+(padT+iH)+'\" stroke=\"var(--vscode-panel-border)\" stroke-width=\"1\"/>'+\n      '<line x1=\"'+padL+'\" y1=\"'+(padT+iH)+'\" x2=\"'+(padL+iW)+'\" y2=\"'+(padT+iH)+'\" stroke=\"var(--vscode-panel-border)\" stroke-width=\"1\"/>'+\n      '</svg>';\n  }\n};\n\nrender();\n})();</script>","stale":false,"executedAt":1790628520273,"columns":["name","order_id","amount"],"rowCount":7},"19":{"sql":"SELECT\n    name,\n    order_id,\n    amount,\n    customers.customer_id\nFROM\n    customers\n    RIGHT JOIN orders ON customers.customer_id = orders.customer_id;","html":"<style>\n.R{font-family:var(--vscode-editor-font-family,monospace);font-size:12.5px;line-height:1.4}\n.TB{display:flex;gap:4px;align-items:center;margin-bottom:8px;flex-wrap:wrap}\n.TG{display:flex;align-items:center;background:var(--vscode-editorWidget-background);border:1px solid var(--vscode-panel-border);border-radius:4px;padding:1px;gap:0}\n.B{padding:3px 9px;font-size:11px;cursor:pointer;color:var(--vscode-foreground);background:transparent;border:none;border-radius:3px;white-space:nowrap;opacity:.85;transition:opacity .1s,background .1s}\n.B:hover{background:var(--vscode-list-hoverBackground);opacity:1}.B:active{transform:scale(.97)}\n.BD{width:1px;height:14px;background:var(--vscode-panel-border);margin:0 1px;align-self:center;flex-shrink:0}\n.F{padding:3px 8px;font-size:11px;background:var(--vscode-input-background);color:var(--vscode-input-foreground);border:1px solid var(--vscode-input-border,rgba(128,128,128,.3));border-radius:3px;width:175px;outline:none;transition:border-color .15s}\n.F:focus{border-color:var(--vscode-focusBorder)}\n.SC{overflow-x:auto;overflow-y:auto;max-height:380px;border:1px solid var(--vscode-panel-border);border-radius:4px}\n.R table{border-collapse:collapse;min-width:100%}\n.R thead{position:sticky;top:0;z-index:2}\n.R th{background:var(--vscode-editorGroupHeader-tabsBackground);color:var(--vscode-descriptionForeground);padding:5px 8px;text-align:left;border-bottom:2px solid var(--vscode-panel-border);border-right:1px solid var(--vscode-panel-border);white-space:nowrap;cursor:pointer;user-select:none;position:relative;font-size:10.5px;font-weight:600;letter-spacing:.04em;text-transform:uppercase}\n.R th:hover{background:var(--vscode-list-hoverBackground)}\n.R th.A::after{content:\" ▲\"}.R th.D::after{content:\" ▼\"}\n.RH{position:absolute;right:0;top:0;bottom:0;width:5px;cursor:col-resize;z-index:3}\n.RH:hover,.RH:active{background:var(--vscode-focusBorder);opacity:.5}\n.R td{padding:4px 8px;border-bottom:1px solid var(--vscode-panel-border);border-right:1px solid var(--vscode-panel-border);color:var(--vscode-editor-foreground);white-space:nowrap;max-width:320px;overflow:hidden;text-overflow:ellipsis;cursor:default;position:relative;vertical-align:middle;font-variant-numeric:tabular-nums}\n.R tr:nth-child(even) td{background:rgba(128,128,128,.04)}\n.R tr:hover td{background:var(--vscode-list-hoverBackground)!important}\n.R tr.HL td{background:var(--vscode-list-activeSelectionBackground)!important;color:var(--vscode-list-activeSelectionForeground)!important}\n.NL{color:var(--vscode-disabledForeground);font-style:italic;font-size:10px;background:rgba(128,128,128,.1);border-radius:2px;padding:0 3px}\n.NR{text-align:right}\n.DAB{position:absolute;left:0;top:1px;bottom:1px;opacity:.13;background:var(--vscode-charts-blue,#3794ff);pointer-events:none;border-radius:0 2px 2px 0}\n.WRP td{white-space:normal!important;word-break:break-word;max-width:none!important}\n.ST{position:fixed;background:var(--vscode-editorWidget-background);border:1px solid var(--vscode-panel-border);border-radius:5px;padding:10px 12px;font-size:11px;color:var(--vscode-editor-foreground);z-index:999;pointer-events:none;min-width:155px;line-height:2;max-width:240px}\n.SK{font-size:10px;color:var(--vscode-descriptionForeground);text-transform:uppercase;letter-spacing:.04em;font-weight:600;display:block;margin-bottom:2px}\n.MR{display:flex;align-items:center;gap:6px;margin-top:6px;font-size:11px;flex-wrap:wrap}\n.MC{color:var(--vscode-descriptionForeground)}.SL{color:var(--vscode-errorForeground)}\n.M{padding:8px 12px;border-radius:4px;font-size:12.5px}\n.MO{color:var(--vscode-terminal-ansiGreen)}.ME{color:var(--vscode-errorForeground);white-space:pre-wrap;font-family:monospace;display:block}\n.CH{margin-top:10px;overflow-x:auto}\n.CL{font-size:10px;fill:var(--vscode-editor-foreground)}.CV{font-size:9px;fill:var(--vscode-descriptionForeground)}\n</style><div class=\"R\" id=\"t9ma6uy7_r\">\n<div class=\"TB\">\n  <input class=\"F\" placeholder=\"Search rows…\" oninput=\"sf_t9ma6uy7(this.value)\" title=\"Filter all columns\"/>\n  <div class=\"TG\">\n    <button class=\"B\" onclick=\"se_t9ma6uy7('csv')\"    title=\"Download all rows as CSV\">CSV</button>\n    <span class=\"BD\"></span>\n    <button class=\"B\" onclick=\"se_t9ma6uy7('xls')\"    title=\"Download as Excel (.xls)\">XLS</button>\n    <span class=\"BD\"></span>\n    <button class=\"B\" onclick=\"se_t9ma6uy7('copy')\"    title=\"Copy all rows as TSV to clipboard (paste into Sheets, Excel, etc.)\">Copy</button>\n  </div>\n  <div class=\"TG\">\n    <button class=\"B\" id=\"t9ma6uy7_wb\" onclick=\"sw_t9ma6uy7()\" title=\"Toggle text wrap\">Wrap</button>\n    <span class=\"BD\"></span>\n    <button class=\"B\" id=\"t9ma6uy7_bb\" onclick=\"sb_t9ma6uy7()\" title=\"Toggle data bars\">Bars</button>\n    <span class=\"BD\"></span><button class=\"B\" id=\"t9ma6uy7_cb\" onclick=\"sc_t9ma6uy7()\" title=\"Toggle chart\">Chart</button>\n  </div>\n</div>\n<div class=\"SC\"><table id=\"t9ma6uy7_t\">\n  <thead><tr id=\"t9ma6uy7_h\"><th onclick=\"ss_t9ma6uy7(0)\" data-col=\"0\" class=\"\">name</th><th onclick=\"ss_t9ma6uy7(1)\" data-col=\"1\" class=\"NR\">order_id</th><th onclick=\"ss_t9ma6uy7(2)\" data-col=\"2\" class=\"NR\">amount</th><th onclick=\"ss_t9ma6uy7(3)\" data-col=\"3\" class=\"NR\">customer_id</th></tr></thead>\n  <tbody id=\"t9ma6uy7_b\"></tbody>\n</table></div>\n<div id=\"t9ma6uy7_f\"></div>\n<div id=\"t9ma6uy7_ch\" class=\"CH\" hidden></div>\n</div>\n<script>(function(){\nvar I='t9ma6uy7',C=[\"name\",\"order_id\",\"amount\",\"customer_id\"],R=[{\"name\":\"Ahmed\",\"order_id\":101,\"amount\":120,\"customer_id\":1},{\"name\":\"Ahmed\",\"order_id\":103,\"amount\":50,\"customer_id\":1},{\"name\":\"Ali\",\"order_id\":102,\"amount\":80,\"customer_id\":2},{\"name\":\"Sara\",\"order_id\":104,\"amount\":200,\"customer_id\":3},{\"name\":\"John\",\"order_id\":106,\"amount\":150,\"customer_id\":4},{\"name\":null,\"order_id\":105,\"amount\":90,\"customer_id\":null}],P=10;\nvar NC=new Set([\"order_id\",\"amount\",\"customer_id\"]);\nvar fil=R.slice(),sc=-1,sd=1,sh=P,wb=false,bb=false;\n\n// ── Pre-compute column stats (min, max, mean, std, nulls, distinct) ────────\nvar CMM={};\nC.forEach(function(c){\n  var all=R.map(function(r){return r[c];});\n  var nulls=all.filter(function(v){return v==null;}).length;\n  var distinct=new Set(all.filter(function(v){return v!=null;}).map(String)).size;\n  var base={total:R.length,nulls:nulls,distinct:distinct};\n  if(!NC.has(c)){CMM[c]=base;return;}\n  var vs=all.filter(function(v){return v!=null&&!isNaN(Number(v));}).map(Number);\n  if(!vs.length){CMM[c]=base;return;}\n  var mn=Math.min.apply(null,vs),mx=Math.max.apply(null,vs);\n  var sum=vs.reduce(function(a,b){return a+b;},0);\n  var mean=sum/vs.length;\n  var std=Math.sqrt(vs.reduce(function(a,v){return a+(v-mean)*(v-mean);},0)/vs.length);\n  CMM[c]=Object.assign(base,{mn:mn,mx:mx,mean:mean,std:std});\n});\n\nfunction xe(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');}\n\nfunction fmt(v){\n  if(v==null)return '<span class=\"NL\">null</span>';\n  return xe(String(v));\n}\n\nfunction copyText(t,cb){\n  if(navigator&&navigator.clipboard){navigator.clipboard.writeText(t).then(cb||function(){},function(){lc2(t);if(cb)cb();});}\n  else{lc2(t);if(cb)cb();}\n}\nfunction lc2(t){var el=document.createElement('textarea');el.value=t;el.style.cssText='position:fixed;opacity:0';document.body.appendChild(el);el.select();try{document.execCommand('copy');}catch(e){}el.remove();}\nfunction dl(content,mime,name){var a=document.createElement('a');a.href='data:'+mime+';charset=utf-8,'+encodeURIComponent(content);a.download=name;a.click();}\nfunction toast(msg){var t=document.createElement('div');t.style.cssText='position:fixed;bottom:20px;right:20px;background:var(--vscode-editorWidget-background);border:1px solid var(--vscode-panel-border);border-radius:4px;padding:6px 12px;font-size:11px;z-index:9999;color:var(--vscode-editor-foreground);transition:opacity .3s';t.textContent=msg;document.body.appendChild(t);setTimeout(function(){t.style.opacity='0';setTimeout(function(){t.remove();},350);},1800);}\n\n\n// ── Core render ────────────────────────────────────────────────────────────\nfunction render(){\n  var tbody=document.getElementById(I+'_b');\n  tbody.innerHTML=fil.slice(0,sh).map(function(row){\n    return '<tr>'+C.map(function(c){\n      var v=row[c];\n      var bar='';\n      if(bb&&CMM[c]&&CMM[c].mn!=null){var mm=CMM[c];var rng=mm.mx-mm.mn;var pct=rng?Math.max(2,Math.round(100*(Number(v)-mm.mn)/rng)):50;bar='<div class=\"DAB\" style=\"width:'+pct+'%\"></div>';}\n      var raw=v==null?'':xe(String(v));\n      return '<td title=\"'+raw+'\" class=\"'+(NC.has(c)?'NR':'')+'\">'+bar+fmt(v)+'</td>';\n    }).join('')+'</tr>';\n  }).join('');\n\n  // Footer\n  var ms=0,tl='0ms';\n  var tc=ms>120000?'SL':'MC';\n  var shown=Math.min(sh,fil.length);\n  var st='Showing '+shown.toLocaleString()+' of '+fil.length.toLocaleString()+' rows';\n  if(6>fil.length)st+=' (6 fetched)';\n  var mb=fil.length>sh?'<button class=\"B\" style=\"padding:1px 8px;border:1px solid var(--vscode-panel-border);border-radius:3px;margin-left:2px\" onclick=\"sm_t9ma6uy7()\">Show '+Math.min(P,fil.length-sh).toLocaleString()+' more ›</button>':'';\n  document.getElementById(I+'_f').innerHTML='<div class=\"MR\"><span class=\"MC\">'+st+'</span>'+mb+'<span class=\"'+tc+'\">&bull; '+tl+(ms>120000?' ⚠ slow':'')+'</span></div>';\n\n  // Sort indicators\n  document.getElementById(I+'_h').querySelectorAll('th').forEach(function(th,i){\n    var base=NC.has(C[i])?'NR':'';\n    th.className=base+(i===sc?(sd===1?' A':' D'):'');\n  });\n}\n\n// ── Actions ────────────────────────────────────────────────────────────────\nwindow['sm_'+I]=function(){sh+=P;render();};\n\nwindow['sf_'+I]=function(v){\n  v=v.toLowerCase();\n  fil=v?R.filter(function(r){return C.some(function(c){return String(r[c]==null?'':r[c]).toLowerCase().includes(v);});}):R.slice();\n  sh=P;render();\n};\n\nwindow['ss_'+I]=function(col){\n  if(sc===col){sd*=-1;}else{sc=col;sd=1;}\n  var k=C[col],isN=NC.has(k);\n  fil.sort(function(a,b){\n    var av=a[k],bv=b[k];\n    if(av==null)return sd;if(bv==null)return -sd;\n    return isN?(Number(av)-Number(bv))*sd:(String(av)<String(bv)?-sd:sd);\n  });\n  sh=P;render();\n};\n\nwindow['sw_'+I]=function(){wb=!wb;document.getElementById(I+'_t').classList.toggle('WRP',wb);document.getElementById(I+'_wb').style.opacity=wb?'1':'.85';};\nwindow['sb_'+I]=function(){bb=!bb;document.getElementById(I+'_bb').style.opacity=bb?'1':'.85';render();};\n\n// ── Export ─────────────────────────────────────────────────────────────────\nwindow['se_'+I]=function(fmt2){\n  if(fmt2==='csv'){\n    var lines=[C.join(',')].concat(R.map(function(r){return C.map(function(c){var v=r[c]==null?'':String(r[c]);return(v.includes(',')||v.includes('\"')||v.includes('\\n'))?'\"'+v.replace(/\"/g,'\"\"')+'\"':v;}).join(',');}));\n    dl(lines.join('\\n'),'text/csv','query_result.csv');\n  } else if(fmt2==='xls'){\n    var xh='<?xml version=\"1.0\"?><Workbook xmlns=\"urn:schemas-microsoft-com:office:spreadsheet\" xmlns:ss=\"urn:schemas-microsoft-com:office:spreadsheet\"><Worksheet ss:Name=\"Results\"><Table>';\n    xh+='<Row>'+C.map(function(c){return '<Cell><Data ss:Type=\"String\">'+xe(c)+'</Data></Cell>';}).join('')+'</Row>';\n    R.forEach(function(r){xh+='<Row>'+C.map(function(c){var v=r[c];if(v==null)return '<Cell><Data ss:Type=\"String\"></Data></Cell>';var n=Number(v);if(!isNaN(n)&&v!=='')return '<Cell><Data ss:Type=\"Number\">'+n+'</Data></Cell>';return '<Cell><Data ss:Type=\"String\">'+xe(String(v))+'</Data></Cell>';}).join('')+'</Row>';});\n    dl(xh+'</Table></Worksheet></Workbook>','application/vnd.ms-excel','query_result.xls');\n  } else if(fmt2==='copy'){\n    var tsv=[C.join('\\t')].concat(R.map(function(r){return C.map(function(c){return r[c]==null?'':String(r[c]).replace(/\\t/g,' ').replace(/\\n/g,' ');}).join('\\t');})).join('\\n');\n    copyText(tsv,function(){toast('Copied '+R.length.toLocaleString()+' rows — paste into Sheets, Excel, etc.');});\n  }\n};\n\n// ── Shift+click row highlight ─────────────────────────────────────────────\ndocument.getElementById(I+'_b').addEventListener('click',function(e){\n  if(!e.shiftKey)return;\n  var td=e.target.closest('td');if(!td)return;\n  td.parentElement.classList.toggle('HL');\n});\n\n// ── Column stats tooltip (uses pre-computed CMM) ──────────────────────────\n(function(){\n  var tip=null;\n  document.getElementById(I+'_h').querySelectorAll('th').forEach(function(th,i){\n    var col=C[i];if(!col)return;\n    th.addEventListener('mouseenter',function(ev){\n      if(ev.relatedTarget&&th.contains(ev.relatedTarget))return;\n      if(!tip){tip=document.createElement('div');tip.className='ST';document.body.appendChild(tip);}\n      var m=CMM[col]||{};\n      var out='<span class=\"SK\">'+xe(col)+'</span>';\n      if(m.total!=null){\n        out+='Rows: '+m.total.toLocaleString()+'<br>';\n        out+='Nulls: '+m.nulls+(m.total?' ('+Math.round(100*m.nulls/m.total)+'%)':'')+'<br>';\n        out+='Distinct: '+m.distinct.toLocaleString()+'<br>';\n        if(m.mn!=null)out+='Min: '+m.mn.toLocaleString()+'<br>Max: '+m.mx.toLocaleString()+'<br>Avg: '+m.mean.toLocaleString(undefined,{maximumFractionDigits:2})+'<br>';\n      }\n      tip.innerHTML=out;\n      var r=th.getBoundingClientRect();tip.style.display='block';\n      tip.style.left=Math.min(r.left,window.innerWidth-180)+'px';tip.style.top=(r.bottom+5)+'px';\n    });\n    th.addEventListener('mouseleave',function(ev){if(tip&&!tip.contains(ev.relatedTarget))tip.style.display='none';});\n  });\n})();\n\n// ── Column resize ─────────────────────────────────────────────────────────\n(function(){\n  document.getElementById(I+'_h').querySelectorAll('th').forEach(function(th){\n    var rh=document.createElement('div');rh.className='RH';\n    rh.addEventListener('mousedown',function(e){\n      var rx=e.clientX,rw=th.offsetWidth;\n      var mv=function(e2){var w=Math.max(40,rw+(e2.clientX-rx));th.style.width=w+'px';th.style.minWidth=w+'px';};\n      var up=function(){document.removeEventListener('mousemove',mv);document.removeEventListener('mouseup',up);};\n      document.addEventListener('mousemove',mv);document.addEventListener('mouseup',up);\n      e.stopPropagation();e.preventDefault();\n    });\n    th.appendChild(rh);\n  });\n})();\n\n// ── Chart: line/area for time-series, bar for everything else ─────────────\n\nwindow['sc_'+I]=function(){\n  var el=document.getElementById(I+'_ch');\n  if(!el.hidden){el.hidden=true;return;}\n  el.hidden=false;\n  var isTS=false;\n  var lc='name',vc='order_id';\n  var cd=fil.slice(0,60);\n  var vs=cd.map(function(r){return Number(r[vc])||0;});\n  var mx=Math.max.apply(null,vs)||1;\n  var mn2=Math.min.apply(null,vs.filter(function(v){return v>0;}))||0;\n  var W=520,H=180,padL=60,padB=28,padT=16,iW=W-padL,iH=H-padB-padT;\n  if(isTS){\n    // ── Line / area chart ────────────────────────────────────────────────\n    var span=mx-mn2||1;\n    var pts=cd.map(function(r,i){\n      var x=padL+Math.round(i*(iW-1)/(Math.max(cd.length-1,1)));\n      var y=padT+Math.round(iH-(Number(r[vc])||0-mn2)/span*iH);\n      return x+','+y;\n    });\n    var areaPath='M'+padL+','+(padT+iH)+' L'+pts.join(' L')+' L'+(padL+iW)+','+(padT+iH)+' Z';\n    var dots=cd.map(function(r,i){\n      var x=padL+Math.round(i*(iW-1)/(Math.max(cd.length-1,1)));\n      var y=padT+Math.round(iH-(Number(r[vc])||0-mn2)/span*iH);\n      var lb=xe(String(r[lc]||'').slice(0,10));\n      var v2=(Number(r[vc])||0).toLocaleString();\n      return '<circle cx=\"'+x+'\" cy=\"'+y+'\" r=\"3\" fill=\"var(--vscode-charts-blue,#3794ff)\" opacity=\".9\">'+\n        '<title>'+lb+': '+v2+'</title></circle>';\n    }).join('');\n    // X axis labels (every Nth label to avoid crowding)\n    var step=Math.ceil(cd.length/8);\n    var xlabels=cd.filter(function(_,i){return i%step===0||i===cd.length-1;}).map(function(r,idx,arr){\n      var origIdx=idx===arr.length-1?cd.length-1:idx*step;\n      var x=padL+Math.round(origIdx*(iW-1)/(Math.max(cd.length-1,1)));\n      return '<text class=\"CV\" x=\"'+x+'\" y=\"'+(H-6)+'\" text-anchor=\"middle\">'+xe(String(r[lc]||'').slice(0,10))+'</text>';\n    }).join('');\n    el.innerHTML='<svg width=\"'+W+'\" height=\"'+H+'\" style=\"overflow:visible\">'+\n      '<defs><linearGradient id=\"ag'+I+'\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0%\" stop-color=\"var(--vscode-charts-blue,#3794ff)\" stop-opacity=\".25\"/><stop offset=\"100%\" stop-color=\"var(--vscode-charts-blue,#3794ff)\" stop-opacity=\".02\"/></linearGradient></defs>'+\n      '<path d=\"'+areaPath+'\" fill=\"url(#ag'+I+')\" />'+\n      '<polyline points=\"'+pts.join(' ')+'\" fill=\"none\" stroke=\"var(--vscode-charts-blue,#3794ff)\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>'+\n      dots+xlabels+\n      '<text class=\"CL\" x=\"'+(padL-8)+'\" y=\"'+(padT)+'\" text-anchor=\"end\">'+xe(vc)+'</text>'+\n      '<line x1=\"'+padL+'\" y1=\"'+padT+'\" x2=\"'+padL+'\" y2=\"'+(padT+iH)+'\" stroke=\"var(--vscode-panel-border)\" stroke-width=\"1\"/>'+\n      '<line x1=\"'+padL+'\" y1=\"'+(padT+iH)+'\" x2=\"'+(padL+iW)+'\" y2=\"'+(padT+iH)+'\" stroke=\"var(--vscode-panel-border)\" stroke-width=\"1\"/>'+\n      '</svg>';\n  } else {\n    // ── Bar chart ────────────────────────────────────────────────────────\n    var bw=Math.max(6,Math.floor(iW/Math.max(cd.length,1))-2);\n    var bars=cd.map(function(r,i){\n      var v2=Number(r[vc])||0;var bh=Math.max(1,Math.round((v2/mx)*iH));\n      var x=padL+i*(bw+2);var y=padT+iH-bh;\n      var lb=xe(String(r[lc]||'').slice(0,8));\n      return '<rect x=\"'+x+'\" y=\"'+y+'\" width=\"'+bw+'\" height=\"'+bh+'\" fill=\"var(--vscode-charts-blue,#3794ff)\" rx=\"1\"/>'+\n        '<text class=\"CV\" x=\"'+(x+bw/2)+'\" y=\"'+(y-2)+'\" text-anchor=\"middle\">'+v2.toLocaleString()+'</text>'+\n        '<text class=\"CV\" x=\"'+(x+bw/2)+'\" y=\"'+(padT+iH+12)+'\" text-anchor=\"middle\">'+lb+'</text>';\n    }).join('');\n    el.innerHTML='<svg width=\"'+W+'\" height=\"'+H+'\" style=\"overflow:visible\">'+\n      '<text class=\"CL\" x=\"'+(padL-10)+'\" y=\"'+(padT+iH/2)+'\" transform=\"rotate(-90,'+(padL-10)+','+(padT+iH/2)+')\" text-anchor=\"middle\">'+xe(vc)+'</text>'+\n      bars+\n      '<line x1=\"'+padL+'\" y1=\"'+padT+'\" x2=\"'+padL+'\" y2=\"'+(padT+iH)+'\" stroke=\"var(--vscode-panel-border)\" stroke-width=\"1\"/>'+\n      '<line x1=\"'+padL+'\" y1=\"'+(padT+iH)+'\" x2=\"'+(padL+iW)+'\" y2=\"'+(padT+iH)+'\" stroke=\"var(--vscode-panel-border)\" stroke-width=\"1\"/>'+\n      '</svg>';\n  }\n};\n\nrender();\n})();</script>","stale":false,"executedAt":1790628523538,"columns":["name","order_id","amount","customer_id"],"rowCount":6},"20":{"sql":"SELECT\n    name,\n    order_id,\n    amount,\n    customers.customer_id\nFROM\n    customers\n    FULL OUTER JOIN orders ON customers.customer_id = orders.customer_id;","html":"<style>\n.R{font-family:var(--vscode-editor-font-family,monospace);font-size:12.5px;line-height:1.4}\n.TB{display:flex;gap:4px;align-items:center;margin-bottom:8px;flex-wrap:wrap}\n.TG{display:flex;align-items:center;background:var(--vscode-editorWidget-background);border:1px solid var(--vscode-panel-border);border-radius:4px;padding:1px;gap:0}\n.B{padding:3px 9px;font-size:11px;cursor:pointer;color:var(--vscode-foreground);background:transparent;border:none;border-radius:3px;white-space:nowrap;opacity:.85;transition:opacity .1s,background .1s}\n.B:hover{background:var(--vscode-list-hoverBackground);opacity:1}.B:active{transform:scale(.97)}\n.BD{width:1px;height:14px;background:var(--vscode-panel-border);margin:0 1px;align-self:center;flex-shrink:0}\n.F{padding:3px 8px;font-size:11px;background:var(--vscode-input-background);color:var(--vscode-input-foreground);border:1px solid var(--vscode-input-border,rgba(128,128,128,.3));border-radius:3px;width:175px;outline:none;transition:border-color .15s}\n.F:focus{border-color:var(--vscode-focusBorder)}\n.SC{overflow-x:auto;overflow-y:auto;max-height:380px;border:1px solid var(--vscode-panel-border);border-radius:4px}\n.R table{border-collapse:collapse;min-width:100%}\n.R thead{position:sticky;top:0;z-index:2}\n.R th{background:var(--vscode-editorGroupHeader-tabsBackground);color:var(--vscode-descriptionForeground);padding:5px 8px;text-align:left;border-bottom:2px solid var(--vscode-panel-border);border-right:1px solid var(--vscode-panel-border);white-space:nowrap;cursor:pointer;user-select:none;position:relative;font-size:10.5px;font-weight:600;letter-spacing:.04em;text-transform:uppercase}\n.R th:hover{background:var(--vscode-list-hoverBackground)}\n.R th.A::after{content:\" ▲\"}.R th.D::after{content:\" ▼\"}\n.RH{position:absolute;right:0;top:0;bottom:0;width:5px;cursor:col-resize;z-index:3}\n.RH:hover,.RH:active{background:var(--vscode-focusBorder);opacity:.5}\n.R td{padding:4px 8px;border-bottom:1px solid var(--vscode-panel-border);border-right:1px solid var(--vscode-panel-border);color:var(--vscode-editor-foreground);white-space:nowrap;max-width:320px;overflow:hidden;text-overflow:ellipsis;cursor:default;position:relative;vertical-align:middle;font-variant-numeric:tabular-nums}\n.R tr:nth-child(even) td{background:rgba(128,128,128,.04)}\n.R tr:hover td{background:var(--vscode-list-hoverBackground)!important}\n.R tr.HL td{background:var(--vscode-list-activeSelectionBackground)!important;color:var(--vscode-list-activeSelectionForeground)!important}\n.NL{color:var(--vscode-disabledForeground);font-style:italic;font-size:10px;background:rgba(128,128,128,.1);border-radius:2px;padding:0 3px}\n.NR{text-align:right}\n.DAB{position:absolute;left:0;top:1px;bottom:1px;opacity:.13;background:var(--vscode-charts-blue,#3794ff);pointer-events:none;border-radius:0 2px 2px 0}\n.WRP td{white-space:normal!important;word-break:break-word;max-width:none!important}\n.ST{position:fixed;background:var(--vscode-editorWidget-background);border:1px solid var(--vscode-panel-border);border-radius:5px;padding:10px 12px;font-size:11px;color:var(--vscode-editor-foreground);z-index:999;pointer-events:none;min-width:155px;line-height:2;max-width:240px}\n.SK{font-size:10px;color:var(--vscode-descriptionForeground);text-transform:uppercase;letter-spacing:.04em;font-weight:600;display:block;margin-bottom:2px}\n.MR{display:flex;align-items:center;gap:6px;margin-top:6px;font-size:11px;flex-wrap:wrap}\n.MC{color:var(--vscode-descriptionForeground)}.SL{color:var(--vscode-errorForeground)}\n.M{padding:8px 12px;border-radius:4px;font-size:12.5px}\n.MO{color:var(--vscode-terminal-ansiGreen)}.ME{color:var(--vscode-errorForeground);white-space:pre-wrap;font-family:monospace;display:block}\n.CH{margin-top:10px;overflow-x:auto}\n.CL{font-size:10px;fill:var(--vscode-editor-foreground)}.CV{font-size:9px;fill:var(--vscode-descriptionForeground)}\n</style><div class=\"R\" id=\"tdbovv9b_r\">\n<div class=\"TB\">\n  <input class=\"F\" placeholder=\"Search rows…\" oninput=\"sf_tdbovv9b(this.value)\" title=\"Filter all columns\"/>\n  <div class=\"TG\">\n    <button class=\"B\" onclick=\"se_tdbovv9b('csv')\"    title=\"Download all rows as CSV\">CSV</button>\n    <span class=\"BD\"></span>\n    <button class=\"B\" onclick=\"se_tdbovv9b('xls')\"    title=\"Download as Excel (.xls)\">XLS</button>\n    <span class=\"BD\"></span>\n    <button class=\"B\" onclick=\"se_tdbovv9b('copy')\"    title=\"Copy all rows as TSV to clipboard (paste into Sheets, Excel, etc.)\">Copy</button>\n  </div>\n  <div class=\"TG\">\n    <button class=\"B\" id=\"tdbovv9b_wb\" onclick=\"sw_tdbovv9b()\" title=\"Toggle text wrap\">Wrap</button>\n    <span class=\"BD\"></span>\n    <button class=\"B\" id=\"tdbovv9b_bb\" onclick=\"sb_tdbovv9b()\" title=\"Toggle data bars\">Bars</button>\n    <span class=\"BD\"></span><button class=\"B\" id=\"tdbovv9b_cb\" onclick=\"sc_tdbovv9b()\" title=\"Toggle chart\">Chart</button>\n  </div>\n</div>\n<div class=\"SC\"><table id=\"tdbovv9b_t\">\n  <thead><tr id=\"tdbovv9b_h\"><th onclick=\"ss_tdbovv9b(0)\" data-col=\"0\" class=\"\">name</th><th onclick=\"ss_tdbovv9b(1)\" data-col=\"1\" class=\"NR\">order_id</th><th onclick=\"ss_tdbovv9b(2)\" data-col=\"2\" class=\"NR\">amount</th><th onclick=\"ss_tdbovv9b(3)\" data-col=\"3\" class=\"NR\">customer_id</th></tr></thead>\n  <tbody id=\"tdbovv9b_b\"></tbody>\n</table></div>\n<div id=\"tdbovv9b_f\"></div>\n<div id=\"tdbovv9b_ch\" class=\"CH\" hidden></div>\n</div>\n<script>(function(){\nvar I='tdbovv9b',C=[\"name\",\"order_id\",\"amount\",\"customer_id\"],R=[{\"name\":\"Ahmed\",\"order_id\":101,\"amount\":120,\"customer_id\":1},{\"name\":\"Ahmed\",\"order_id\":103,\"amount\":50,\"customer_id\":1},{\"name\":\"Ali\",\"order_id\":102,\"amount\":80,\"customer_id\":2},{\"name\":\"Sara\",\"order_id\":104,\"amount\":200,\"customer_id\":3},{\"name\":\"John\",\"order_id\":106,\"amount\":150,\"customer_id\":4},{\"name\":\"Maria\",\"order_id\":null,\"amount\":null,\"customer_id\":5},{\"name\":\"David\",\"order_id\":null,\"amount\":null,\"customer_id\":6},{\"name\":null,\"order_id\":105,\"amount\":90,\"customer_id\":null}],P=10;\nvar NC=new Set([\"order_id\",\"amount\",\"customer_id\"]);\nvar fil=R.slice(),sc=-1,sd=1,sh=P,wb=false,bb=false;\n\n// ── Pre-compute column stats (min, max, mean, std, nulls, distinct) ────────\nvar CMM={};\nC.forEach(function(c){\n  var all=R.map(function(r){return r[c];});\n  var nulls=all.filter(function(v){return v==null;}).length;\n  var distinct=new Set(all.filter(function(v){return v!=null;}).map(String)).size;\n  var base={total:R.length,nulls:nulls,distinct:distinct};\n  if(!NC.has(c)){CMM[c]=base;return;}\n  var vs=all.filter(function(v){return v!=null&&!isNaN(Number(v));}).map(Number);\n  if(!vs.length){CMM[c]=base;return;}\n  var mn=Math.min.apply(null,vs),mx=Math.max.apply(null,vs);\n  var sum=vs.reduce(function(a,b){return a+b;},0);\n  var mean=sum/vs.length;\n  var std=Math.sqrt(vs.reduce(function(a,v){return a+(v-mean)*(v-mean);},0)/vs.length);\n  CMM[c]=Object.assign(base,{mn:mn,mx:mx,mean:mean,std:std});\n});\n\nfunction xe(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');}\n\nfunction fmt(v){\n  if(v==null)return '<span class=\"NL\">null</span>';\n  return xe(String(v));\n}\n\nfunction copyText(t,cb){\n  if(navigator&&navigator.clipboard){navigator.clipboard.writeText(t).then(cb||function(){},function(){lc2(t);if(cb)cb();});}\n  else{lc2(t);if(cb)cb();}\n}\nfunction lc2(t){var el=document.createElement('textarea');el.value=t;el.style.cssText='position:fixed;opacity:0';document.body.appendChild(el);el.select();try{document.execCommand('copy');}catch(e){}el.remove();}\nfunction dl(content,mime,name){var a=document.createElement('a');a.href='data:'+mime+';charset=utf-8,'+encodeURIComponent(content);a.download=name;a.click();}\nfunction toast(msg){var t=document.createElement('div');t.style.cssText='position:fixed;bottom:20px;right:20px;background:var(--vscode-editorWidget-background);border:1px solid var(--vscode-panel-border);border-radius:4px;padding:6px 12px;font-size:11px;z-index:9999;color:var(--vscode-editor-foreground);transition:opacity .3s';t.textContent=msg;document.body.appendChild(t);setTimeout(function(){t.style.opacity='0';setTimeout(function(){t.remove();},350);},1800);}\n\n\n// ── Core render ────────────────────────────────────────────────────────────\nfunction render(){\n  var tbody=document.getElementById(I+'_b');\n  tbody.innerHTML=fil.slice(0,sh).map(function(row){\n    return '<tr>'+C.map(function(c){\n      var v=row[c];\n      var bar='';\n      if(bb&&CMM[c]&&CMM[c].mn!=null){var mm=CMM[c];var rng=mm.mx-mm.mn;var pct=rng?Math.max(2,Math.round(100*(Number(v)-mm.mn)/rng)):50;bar='<div class=\"DAB\" style=\"width:'+pct+'%\"></div>';}\n      var raw=v==null?'':xe(String(v));\n      return '<td title=\"'+raw+'\" class=\"'+(NC.has(c)?'NR':'')+'\">'+bar+fmt(v)+'</td>';\n    }).join('')+'</tr>';\n  }).join('');\n\n  // Footer\n  var ms=0,tl='0ms';\n  var tc=ms>120000?'SL':'MC';\n  var shown=Math.min(sh,fil.length);\n  var st='Showing '+shown.toLocaleString()+' of '+fil.length.toLocaleString()+' rows';\n  if(8>fil.length)st+=' (8 fetched)';\n  var mb=fil.length>sh?'<button class=\"B\" style=\"padding:1px 8px;border:1px solid var(--vscode-panel-border);border-radius:3px;margin-left:2px\" onclick=\"sm_tdbovv9b()\">Show '+Math.min(P,fil.length-sh).toLocaleString()+' more ›</button>':'';\n  document.getElementById(I+'_f').innerHTML='<div class=\"MR\"><span class=\"MC\">'+st+'</span>'+mb+'<span class=\"'+tc+'\">&bull; '+tl+(ms>120000?' ⚠ slow':'')+'</span></div>';\n\n  // Sort indicators\n  document.getElementById(I+'_h').querySelectorAll('th').forEach(function(th,i){\n    var base=NC.has(C[i])?'NR':'';\n    th.className=base+(i===sc?(sd===1?' A':' D'):'');\n  });\n}\n\n// ── Actions ────────────────────────────────────────────────────────────────\nwindow['sm_'+I]=function(){sh+=P;render();};\n\nwindow['sf_'+I]=function(v){\n  v=v.toLowerCase();\n  fil=v?R.filter(function(r){return C.some(function(c){return String(r[c]==null?'':r[c]).toLowerCase().includes(v);});}):R.slice();\n  sh=P;render();\n};\n\nwindow['ss_'+I]=function(col){\n  if(sc===col){sd*=-1;}else{sc=col;sd=1;}\n  var k=C[col],isN=NC.has(k);\n  fil.sort(function(a,b){\n    var av=a[k],bv=b[k];\n    if(av==null)return sd;if(bv==null)return -sd;\n    return isN?(Number(av)-Number(bv))*sd:(String(av)<String(bv)?-sd:sd);\n  });\n  sh=P;render();\n};\n\nwindow['sw_'+I]=function(){wb=!wb;document.getElementById(I+'_t').classList.toggle('WRP',wb);document.getElementById(I+'_wb').style.opacity=wb?'1':'.85';};\nwindow['sb_'+I]=function(){bb=!bb;document.getElementById(I+'_bb').style.opacity=bb?'1':'.85';render();};\n\n// ── Export ─────────────────────────────────────────────────────────────────\nwindow['se_'+I]=function(fmt2){\n  if(fmt2==='csv'){\n    var lines=[C.join(',')].concat(R.map(function(r){return C.map(function(c){var v=r[c]==null?'':String(r[c]);return(v.includes(',')||v.includes('\"')||v.includes('\\n'))?'\"'+v.replace(/\"/g,'\"\"')+'\"':v;}).join(',');}));\n    dl(lines.join('\\n'),'text/csv','query_result.csv');\n  } else if(fmt2==='xls'){\n    var xh='<?xml version=\"1.0\"?><Workbook xmlns=\"urn:schemas-microsoft-com:office:spreadsheet\" xmlns:ss=\"urn:schemas-microsoft-com:office:spreadsheet\"><Worksheet ss:Name=\"Results\"><Table>';\n    xh+='<Row>'+C.map(function(c){return '<Cell><Data ss:Type=\"String\">'+xe(c)+'</Data></Cell>';}).join('')+'</Row>';\n    R.forEach(function(r){xh+='<Row>'+C.map(function(c){var v=r[c];if(v==null)return '<Cell><Data ss:Type=\"String\"></Data></Cell>';var n=Number(v);if(!isNaN(n)&&v!=='')return '<Cell><Data ss:Type=\"Number\">'+n+'</Data></Cell>';return '<Cell><Data ss:Type=\"String\">'+xe(String(v))+'</Data></Cell>';}).join('')+'</Row>';});\n    dl(xh+'</Table></Worksheet></Workbook>','application/vnd.ms-excel','query_result.xls');\n  } else if(fmt2==='copy'){\n    var tsv=[C.join('\\t')].concat(R.map(function(r){return C.map(function(c){return r[c]==null?'':String(r[c]).replace(/\\t/g,' ').replace(/\\n/g,' ');}).join('\\t');})).join('\\n');\n    copyText(tsv,function(){toast('Copied '+R.length.toLocaleString()+' rows — paste into Sheets, Excel, etc.');});\n  }\n};\n\n// ── Shift+click row highlight ─────────────────────────────────────────────\ndocument.getElementById(I+'_b').addEventListener('click',function(e){\n  if(!e.shiftKey)return;\n  var td=e.target.closest('td');if(!td)return;\n  td.parentElement.classList.toggle('HL');\n});\n\n// ── Column stats tooltip (uses pre-computed CMM) ──────────────────────────\n(function(){\n  var tip=null;\n  document.getElementById(I+'_h').querySelectorAll('th').forEach(function(th,i){\n    var col=C[i];if(!col)return;\n    th.addEventListener('mouseenter',function(ev){\n      if(ev.relatedTarget&&th.contains(ev.relatedTarget))return;\n      if(!tip){tip=document.createElement('div');tip.className='ST';document.body.appendChild(tip);}\n      var m=CMM[col]||{};\n      var out='<span class=\"SK\">'+xe(col)+'</span>';\n      if(m.total!=null){\n        out+='Rows: '+m.total.toLocaleString()+'<br>';\n        out+='Nulls: '+m.nulls+(m.total?' ('+Math.round(100*m.nulls/m.total)+'%)':'')+'<br>';\n        out+='Distinct: '+m.distinct.toLocaleString()+'<br>';\n        if(m.mn!=null)out+='Min: '+m.mn.toLocaleString()+'<br>Max: '+m.mx.toLocaleString()+'<br>Avg: '+m.mean.toLocaleString(undefined,{maximumFractionDigits:2})+'<br>';\n      }\n      tip.innerHTML=out;\n      var r=th.getBoundingClientRect();tip.style.display='block';\n      tip.style.left=Math.min(r.left,window.innerWidth-180)+'px';tip.style.top=(r.bottom+5)+'px';\n    });\n    th.addEventListener('mouseleave',function(ev){if(tip&&!tip.contains(ev.relatedTarget))tip.style.display='none';});\n  });\n})();\n\n// ── Column resize ─────────────────────────────────────────────────────────\n(function(){\n  document.getElementById(I+'_h').querySelectorAll('th').forEach(function(th){\n    var rh=document.createElement('div');rh.className='RH';\n    rh.addEventListener('mousedown',function(e){\n      var rx=e.clientX,rw=th.offsetWidth;\n      var mv=function(e2){var w=Math.max(40,rw+(e2.clientX-rx));th.style.width=w+'px';th.style.minWidth=w+'px';};\n      var up=function(){document.removeEventListener('mousemove',mv);document.removeEventListener('mouseup',up);};\n      document.addEventListener('mousemove',mv);document.addEventListener('mouseup',up);\n      e.stopPropagation();e.preventDefault();\n    });\n    th.appendChild(rh);\n  });\n})();\n\n// ── Chart: line/area for time-series, bar for everything else ─────────────\n\nwindow['sc_'+I]=function(){\n  var el=document.getElementById(I+'_ch');\n  if(!el.hidden){el.hidden=true;return;}\n  el.hidden=false;\n  var isTS=false;\n  var lc='name',vc='order_id';\n  var cd=fil.slice(0,60);\n  var vs=cd.map(function(r){return Number(r[vc])||0;});\n  var mx=Math.max.apply(null,vs)||1;\n  var mn2=Math.min.apply(null,vs.filter(function(v){return v>0;}))||0;\n  var W=520,H=180,padL=60,padB=28,padT=16,iW=W-padL,iH=H-padB-padT;\n  if(isTS){\n    // ── Line / area chart ────────────────────────────────────────────────\n    var span=mx-mn2||1;\n    var pts=cd.map(function(r,i){\n      var x=padL+Math.round(i*(iW-1)/(Math.max(cd.length-1,1)));\n      var y=padT+Math.round(iH-(Number(r[vc])||0-mn2)/span*iH);\n      return x+','+y;\n    });\n    var areaPath='M'+padL+','+(padT+iH)+' L'+pts.join(' L')+' L'+(padL+iW)+','+(padT+iH)+' Z';\n    var dots=cd.map(function(r,i){\n      var x=padL+Math.round(i*(iW-1)/(Math.max(cd.length-1,1)));\n      var y=padT+Math.round(iH-(Number(r[vc])||0-mn2)/span*iH);\n      var lb=xe(String(r[lc]||'').slice(0,10));\n      var v2=(Number(r[vc])||0).toLocaleString();\n      return '<circle cx=\"'+x+'\" cy=\"'+y+'\" r=\"3\" fill=\"var(--vscode-charts-blue,#3794ff)\" opacity=\".9\">'+\n        '<title>'+lb+': '+v2+'</title></circle>';\n    }).join('');\n    // X axis labels (every Nth label to avoid crowding)\n    var step=Math.ceil(cd.length/8);\n    var xlabels=cd.filter(function(_,i){return i%step===0||i===cd.length-1;}).map(function(r,idx,arr){\n      var origIdx=idx===arr.length-1?cd.length-1:idx*step;\n      var x=padL+Math.round(origIdx*(iW-1)/(Math.max(cd.length-1,1)));\n      return '<text class=\"CV\" x=\"'+x+'\" y=\"'+(H-6)+'\" text-anchor=\"middle\">'+xe(String(r[lc]||'').slice(0,10))+'</text>';\n    }).join('');\n    el.innerHTML='<svg width=\"'+W+'\" height=\"'+H+'\" style=\"overflow:visible\">'+\n      '<defs><linearGradient id=\"ag'+I+'\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0%\" stop-color=\"var(--vscode-charts-blue,#3794ff)\" stop-opacity=\".25\"/><stop offset=\"100%\" stop-color=\"var(--vscode-charts-blue,#3794ff)\" stop-opacity=\".02\"/></linearGradient></defs>'+\n      '<path d=\"'+areaPath+'\" fill=\"url(#ag'+I+')\" />'+\n      '<polyline points=\"'+pts.join(' ')+'\" fill=\"none\" stroke=\"var(--vscode-charts-blue,#3794ff)\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>'+\n      dots+xlabels+\n      '<text class=\"CL\" x=\"'+(padL-8)+'\" y=\"'+(padT)+'\" text-anchor=\"end\">'+xe(vc)+'</text>'+\n      '<line x1=\"'+padL+'\" y1=\"'+padT+'\" x2=\"'+padL+'\" y2=\"'+(padT+iH)+'\" stroke=\"var(--vscode-panel-border)\" stroke-width=\"1\"/>'+\n      '<line x1=\"'+padL+'\" y1=\"'+(padT+iH)+'\" x2=\"'+(padL+iW)+'\" y2=\"'+(padT+iH)+'\" stroke=\"var(--vscode-panel-border)\" stroke-width=\"1\"/>'+\n      '</svg>';\n  } else {\n    // ── Bar chart ────────────────────────────────────────────────────────\n    var bw=Math.max(6,Math.floor(iW/Math.max(cd.length,1))-2);\n    var bars=cd.map(function(r,i){\n      var v2=Number(r[vc])||0;var bh=Math.max(1,Math.round((v2/mx)*iH));\n      var x=padL+i*(bw+2);var y=padT+iH-bh;\n      var lb=xe(String(r[lc]||'').slice(0,8));\n      return '<rect x=\"'+x+'\" y=\"'+y+'\" width=\"'+bw+'\" height=\"'+bh+'\" fill=\"var(--vscode-charts-blue,#3794ff)\" rx=\"1\"/>'+\n        '<text class=\"CV\" x=\"'+(x+bw/2)+'\" y=\"'+(y-2)+'\" text-anchor=\"middle\">'+v2.toLocaleString()+'</text>'+\n        '<text class=\"CV\" x=\"'+(x+bw/2)+'\" y=\"'+(padT+iH+12)+'\" text-anchor=\"middle\">'+lb+'</text>';\n    }).join('');\n    el.innerHTML='<svg width=\"'+W+'\" height=\"'+H+'\" style=\"overflow:visible\">'+\n      '<text class=\"CL\" x=\"'+(padL-10)+'\" y=\"'+(padT+iH/2)+'\" transform=\"rotate(-90,'+(padL-10)+','+(padT+iH/2)+')\" text-anchor=\"middle\">'+xe(vc)+'</text>'+\n      bars+\n      '<line x1=\"'+padL+'\" y1=\"'+padT+'\" x2=\"'+padL+'\" y2=\"'+(padT+iH)+'\" stroke=\"var(--vscode-panel-border)\" stroke-width=\"1\"/>'+\n      '<line x1=\"'+padL+'\" y1=\"'+(padT+iH)+'\" x2=\"'+(padL+iW)+'\" y2=\"'+(padT+iH)+'\" stroke=\"var(--vscode-panel-border)\" stroke-width=\"1\"/>'+\n      '</svg>';\n  }\n};\n\nrender();\n})();</script>","stale":false,"executedAt":1790628530870,"columns":["name","order_id","amount","customer_id"],"rowCount":8},"21":{"sql":"SELECT\n    \n    orders.order_id,\n    products.product_name,\n    orders.amount\nFROM\n    products\n    LEFT JOIN orders ON products.product_id = orders.product_id;","html":"<style>\n.R{font-family:var(--vscode-editor-font-family,monospace);font-size:12.5px;line-height:1.4}\n.TB{display:flex;gap:4px;align-items:center;margin-bottom:8px;flex-wrap:wrap}\n.TG{display:flex;align-items:center;background:var(--vscode-editorWidget-background);border:1px solid var(--vscode-panel-border);border-radius:4px;padding:1px;gap:0}\n.B{padding:3px 9px;font-size:11px;cursor:pointer;color:var(--vscode-foreground);background:transparent;border:none;border-radius:3px;white-space:nowrap;opacity:.85;transition:opacity .1s,background .1s}\n.B:hover{background:var(--vscode-list-hoverBackground);opacity:1}.B:active{transform:scale(.97)}\n.BD{width:1px;height:14px;background:var(--vscode-panel-border);margin:0 1px;align-self:center;flex-shrink:0}\n.F{padding:3px 8px;font-size:11px;background:var(--vscode-input-background);color:var(--vscode-input-foreground);border:1px solid var(--vscode-input-border,rgba(128,128,128,.3));border-radius:3px;width:175px;outline:none;transition:border-color .15s}\n.F:focus{border-color:var(--vscode-focusBorder)}\n.SC{overflow-x:auto;overflow-y:auto;max-height:380px;border:1px solid var(--vscode-panel-border);border-radius:4px}\n.R table{border-collapse:collapse;min-width:100%}\n.R thead{position:sticky;top:0;z-index:2}\n.R th{background:var(--vscode-editorGroupHeader-tabsBackground);color:var(--vscode-descriptionForeground);padding:5px 8px;text-align:left;border-bottom:2px solid var(--vscode-panel-border);border-right:1px solid var(--vscode-panel-border);white-space:nowrap;cursor:pointer;user-select:none;position:relative;font-size:10.5px;font-weight:600;letter-spacing:.04em;text-transform:uppercase}\n.R th:hover{background:var(--vscode-list-hoverBackground)}\n.R th.A::after{content:\" ▲\"}.R th.D::after{content:\" ▼\"}\n.RH{position:absolute;right:0;top:0;bottom:0;width:5px;cursor:col-resize;z-index:3}\n.RH:hover,.RH:active{background:var(--vscode-focusBorder);opacity:.5}\n.R td{padding:4px 8px;border-bottom:1px solid var(--vscode-panel-border);border-right:1px solid var(--vscode-panel-border);color:var(--vscode-editor-foreground);white-space:nowrap;max-width:320px;overflow:hidden;text-overflow:ellipsis;cursor:default;position:relative;vertical-align:middle;font-variant-numeric:tabular-nums}\n.R tr:nth-child(even) td{background:rgba(128,128,128,.04)}\n.R tr:hover td{background:var(--vscode-list-hoverBackground)!important}\n.R tr.HL td{background:var(--vscode-list-activeSelectionBackground)!important;color:var(--vscode-list-activeSelectionForeground)!important}\n.NL{color:var(--vscode-disabledForeground);font-style:italic;font-size:10px;background:rgba(128,128,128,.1);border-radius:2px;padding:0 3px}\n.NR{text-align:right}\n.DAB{position:absolute;left:0;top:1px;bottom:1px;opacity:.13;background:var(--vscode-charts-blue,#3794ff);pointer-events:none;border-radius:0 2px 2px 0}\n.WRP td{white-space:normal!important;word-break:break-word;max-width:none!important}\n.ST{position:fixed;background:var(--vscode-editorWidget-background);border:1px solid var(--vscode-panel-border);border-radius:5px;padding:10px 12px;font-size:11px;color:var(--vscode-editor-foreground);z-index:999;pointer-events:none;min-width:155px;line-height:2;max-width:240px}\n.SK{font-size:10px;color:var(--vscode-descriptionForeground);text-transform:uppercase;letter-spacing:.04em;font-weight:600;display:block;margin-bottom:2px}\n.MR{display:flex;align-items:center;gap:6px;margin-top:6px;font-size:11px;flex-wrap:wrap}\n.MC{color:var(--vscode-descriptionForeground)}.SL{color:var(--vscode-errorForeground)}\n.M{padding:8px 12px;border-radius:4px;font-size:12.5px}\n.MO{color:var(--vscode-terminal-ansiGreen)}.ME{color:var(--vscode-errorForeground);white-space:pre-wrap;font-family:monospace;display:block}\n.CH{margin-top:10px;overflow-x:auto}\n.CL{font-size:10px;fill:var(--vscode-editor-foreground)}.CV{font-size:9px;fill:var(--vscode-descriptionForeground)}\n</style><div class=\"R\" id=\"t6j2nrl9_r\">\n<div class=\"TB\">\n  <input class=\"F\" placeholder=\"Search rows…\" oninput=\"sf_t6j2nrl9(this.value)\" title=\"Filter all columns\"/>\n  <div class=\"TG\">\n    <button class=\"B\" onclick=\"se_t6j2nrl9('csv')\"    title=\"Download all rows as CSV\">CSV</button>\n    <span class=\"BD\"></span>\n    <button class=\"B\" onclick=\"se_t6j2nrl9('xls')\"    title=\"Download as Excel (.xls)\">XLS</button>\n    <span class=\"BD\"></span>\n    <button class=\"B\" onclick=\"se_t6j2nrl9('copy')\"    title=\"Copy all rows as TSV to clipboard (paste into Sheets, Excel, etc.)\">Copy</button>\n  </div>\n  <div class=\"TG\">\n    <button class=\"B\" id=\"t6j2nrl9_wb\" onclick=\"sw_t6j2nrl9()\" title=\"Toggle text wrap\">Wrap</button>\n    <span class=\"BD\"></span>\n    <button class=\"B\" id=\"t6j2nrl9_bb\" onclick=\"sb_t6j2nrl9()\" title=\"Toggle data bars\">Bars</button>\n    <span class=\"BD\"></span><button class=\"B\" id=\"t6j2nrl9_cb\" onclick=\"sc_t6j2nrl9()\" title=\"Toggle chart\">Chart</button>\n  </div>\n</div>\n<div class=\"SC\"><table id=\"t6j2nrl9_t\">\n  <thead><tr id=\"t6j2nrl9_h\"><th onclick=\"ss_t6j2nrl9(0)\" data-col=\"0\" class=\"NR\">order_id</th><th onclick=\"ss_t6j2nrl9(1)\" data-col=\"1\" class=\"\">product_name</th><th onclick=\"ss_t6j2nrl9(2)\" data-col=\"2\" class=\"NR\">amount</th></tr></thead>\n  <tbody id=\"t6j2nrl9_b\"></tbody>\n</table></div>\n<div id=\"t6j2nrl9_f\"></div>\n<div id=\"t6j2nrl9_ch\" class=\"CH\" hidden></div>\n</div>\n<script>(function(){\nvar I='t6j2nrl9',C=[\"order_id\",\"product_name\",\"amount\"],R=[{\"order_id\":101,\"product_name\":\"Laptop\",\"amount\":120},{\"order_id\":104,\"product_name\":\"Laptop\",\"amount\":200},{\"order_id\":102,\"product_name\":\"Mouse\",\"amount\":80},{\"order_id\":105,\"product_name\":\"Mouse\",\"amount\":90},{\"order_id\":103,\"product_name\":\"Keyboard\",\"amount\":50},{\"order_id\":106,\"product_name\":\"Chair\",\"amount\":150},{\"order_id\":null,\"product_name\":\"Desk\",\"amount\":null}],P=10;\nvar NC=new Set([\"order_id\",\"amount\"]);\nvar fil=R.slice(),sc=-1,sd=1,sh=P,wb=false,bb=false;\n\n// ── Pre-compute column stats (min, max, mean, std, nulls, distinct) ────────\nvar CMM={};\nC.forEach(function(c){\n  var all=R.map(function(r){return r[c];});\n  var nulls=all.filter(function(v){return v==null;}).length;\n  var distinct=new Set(all.filter(function(v){return v!=null;}).map(String)).size;\n  var base={total:R.length,nulls:nulls,distinct:distinct};\n  if(!NC.has(c)){CMM[c]=base;return;}\n  var vs=all.filter(function(v){return v!=null&&!isNaN(Number(v));}).map(Number);\n  if(!vs.length){CMM[c]=base;return;}\n  var mn=Math.min.apply(null,vs),mx=Math.max.apply(null,vs);\n  var sum=vs.reduce(function(a,b){return a+b;},0);\n  var mean=sum/vs.length;\n  var std=Math.sqrt(vs.reduce(function(a,v){return a+(v-mean)*(v-mean);},0)/vs.length);\n  CMM[c]=Object.assign(base,{mn:mn,mx:mx,mean:mean,std:std});\n});\n\nfunction xe(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');}\n\nfunction fmt(v){\n  if(v==null)return '<span class=\"NL\">null</span>';\n  return xe(String(v));\n}\n\nfunction copyText(t,cb){\n  if(navigator&&navigator.clipboard){navigator.clipboard.writeText(t).then(cb||function(){},function(){lc2(t);if(cb)cb();});}\n  else{lc2(t);if(cb)cb();}\n}\nfunction lc2(t){var el=document.createElement('textarea');el.value=t;el.style.cssText='position:fixed;opacity:0';document.body.appendChild(el);el.select();try{document.execCommand('copy');}catch(e){}el.remove();}\nfunction dl(content,mime,name){var a=document.createElement('a');a.href='data:'+mime+';charset=utf-8,'+encodeURIComponent(content);a.download=name;a.click();}\nfunction toast(msg){var t=document.createElement('div');t.style.cssText='position:fixed;bottom:20px;right:20px;background:var(--vscode-editorWidget-background);border:1px solid var(--vscode-panel-border);border-radius:4px;padding:6px 12px;font-size:11px;z-index:9999;color:var(--vscode-editor-foreground);transition:opacity .3s';t.textContent=msg;document.body.appendChild(t);setTimeout(function(){t.style.opacity='0';setTimeout(function(){t.remove();},350);},1800);}\n\n\n// ── Core render ────────────────────────────────────────────────────────────\nfunction render(){\n  var tbody=document.getElementById(I+'_b');\n  tbody.innerHTML=fil.slice(0,sh).map(function(row){\n    return '<tr>'+C.map(function(c){\n      var v=row[c];\n      var bar='';\n      if(bb&&CMM[c]&&CMM[c].mn!=null){var mm=CMM[c];var rng=mm.mx-mm.mn;var pct=rng?Math.max(2,Math.round(100*(Number(v)-mm.mn)/rng)):50;bar='<div class=\"DAB\" style=\"width:'+pct+'%\"></div>';}\n      var raw=v==null?'':xe(String(v));\n      return '<td title=\"'+raw+'\" class=\"'+(NC.has(c)?'NR':'')+'\">'+bar+fmt(v)+'</td>';\n    }).join('')+'</tr>';\n  }).join('');\n\n  // Footer\n  var ms=1,tl='1ms';\n  var tc=ms>120000?'SL':'MC';\n  var shown=Math.min(sh,fil.length);\n  var st='Showing '+shown.toLocaleString()+' of '+fil.length.toLocaleString()+' rows';\n  if(7>fil.length)st+=' (7 fetched)';\n  var mb=fil.length>sh?'<button class=\"B\" style=\"padding:1px 8px;border:1px solid var(--vscode-panel-border);border-radius:3px;margin-left:2px\" onclick=\"sm_t6j2nrl9()\">Show '+Math.min(P,fil.length-sh).toLocaleString()+' more ›</button>':'';\n  document.getElementById(I+'_f').innerHTML='<div class=\"MR\"><span class=\"MC\">'+st+'</span>'+mb+'<span class=\"'+tc+'\">&bull; '+tl+(ms>120000?' ⚠ slow':'')+'</span></div>';\n\n  // Sort indicators\n  document.getElementById(I+'_h').querySelectorAll('th').forEach(function(th,i){\n    var base=NC.has(C[i])?'NR':'';\n    th.className=base+(i===sc?(sd===1?' A':' D'):'');\n  });\n}\n\n// ── Actions ────────────────────────────────────────────────────────────────\nwindow['sm_'+I]=function(){sh+=P;render();};\n\nwindow['sf_'+I]=function(v){\n  v=v.toLowerCase();\n  fil=v?R.filter(function(r){return C.some(function(c){return String(r[c]==null?'':r[c]).toLowerCase().includes(v);});}):R.slice();\n  sh=P;render();\n};\n\nwindow['ss_'+I]=function(col){\n  if(sc===col){sd*=-1;}else{sc=col;sd=1;}\n  var k=C[col],isN=NC.has(k);\n  fil.sort(function(a,b){\n    var av=a[k],bv=b[k];\n    if(av==null)return sd;if(bv==null)return -sd;\n    return isN?(Number(av)-Number(bv))*sd:(String(av)<String(bv)?-sd:sd);\n  });\n  sh=P;render();\n};\n\nwindow['sw_'+I]=function(){wb=!wb;document.getElementById(I+'_t').classList.toggle('WRP',wb);document.getElementById(I+'_wb').style.opacity=wb?'1':'.85';};\nwindow['sb_'+I]=function(){bb=!bb;document.getElementById(I+'_bb').style.opacity=bb?'1':'.85';render();};\n\n// ── Export ─────────────────────────────────────────────────────────────────\nwindow['se_'+I]=function(fmt2){\n  if(fmt2==='csv'){\n    var lines=[C.join(',')].concat(R.map(function(r){return C.map(function(c){var v=r[c]==null?'':String(r[c]);return(v.includes(',')||v.includes('\"')||v.includes('\\n'))?'\"'+v.replace(/\"/g,'\"\"')+'\"':v;}).join(',');}));\n    dl(lines.join('\\n'),'text/csv','query_result.csv');\n  } else if(fmt2==='xls'){\n    var xh='<?xml version=\"1.0\"?><Workbook xmlns=\"urn:schemas-microsoft-com:office:spreadsheet\" xmlns:ss=\"urn:schemas-microsoft-com:office:spreadsheet\"><Worksheet ss:Name=\"Results\"><Table>';\n    xh+='<Row>'+C.map(function(c){return '<Cell><Data ss:Type=\"String\">'+xe(c)+'</Data></Cell>';}).join('')+'</Row>';\n    R.forEach(function(r){xh+='<Row>'+C.map(function(c){var v=r[c];if(v==null)return '<Cell><Data ss:Type=\"String\"></Data></Cell>';var n=Number(v);if(!isNaN(n)&&v!=='')return '<Cell><Data ss:Type=\"Number\">'+n+'</Data></Cell>';return '<Cell><Data ss:Type=\"String\">'+xe(String(v))+'</Data></Cell>';}).join('')+'</Row>';});\n    dl(xh+'</Table></Worksheet></Workbook>','application/vnd.ms-excel','query_result.xls');\n  } else if(fmt2==='copy'){\n    var tsv=[C.join('\\t')].concat(R.map(function(r){return C.map(function(c){return r[c]==null?'':String(r[c]).replace(/\\t/g,' ').replace(/\\n/g,' ');}).join('\\t');})).join('\\n');\n    copyText(tsv,function(){toast('Copied '+R.length.toLocaleString()+' rows — paste into Sheets, Excel, etc.');});\n  }\n};\n\n// ── Shift+click row highlight ─────────────────────────────────────────────\ndocument.getElementById(I+'_b').addEventListener('click',function(e){\n  if(!e.shiftKey)return;\n  var td=e.target.closest('td');if(!td)return;\n  td.parentElement.classList.toggle('HL');\n});\n\n// ── Column stats tooltip (uses pre-computed CMM) ──────────────────────────\n(function(){\n  var tip=null;\n  document.getElementById(I+'_h').querySelectorAll('th').forEach(function(th,i){\n    var col=C[i];if(!col)return;\n    th.addEventListener('mouseenter',function(ev){\n      if(ev.relatedTarget&&th.contains(ev.relatedTarget))return;\n      if(!tip){tip=document.createElement('div');tip.className='ST';document.body.appendChild(tip);}\n      var m=CMM[col]||{};\n      var out='<span class=\"SK\">'+xe(col)+'</span>';\n      if(m.total!=null){\n        out+='Rows: '+m.total.toLocaleString()+'<br>';\n        out+='Nulls: '+m.nulls+(m.total?' ('+Math.round(100*m.nulls/m.total)+'%)':'')+'<br>';\n        out+='Distinct: '+m.distinct.toLocaleString()+'<br>';\n        if(m.mn!=null)out+='Min: '+m.mn.toLocaleString()+'<br>Max: '+m.mx.toLocaleString()+'<br>Avg: '+m.mean.toLocaleString(undefined,{maximumFractionDigits:2})+'<br>';\n      }\n      tip.innerHTML=out;\n      var r=th.getBoundingClientRect();tip.style.display='block';\n      tip.style.left=Math.min(r.left,window.innerWidth-180)+'px';tip.style.top=(r.bottom+5)+'px';\n    });\n    th.addEventListener('mouseleave',function(ev){if(tip&&!tip.contains(ev.relatedTarget))tip.style.display='none';});\n  });\n})();\n\n// ── Column resize ─────────────────────────────────────────────────────────\n(function(){\n  document.getElementById(I+'_h').querySelectorAll('th').forEach(function(th){\n    var rh=document.createElement('div');rh.className='RH';\n    rh.addEventListener('mousedown',function(e){\n      var rx=e.clientX,rw=th.offsetWidth;\n      var mv=function(e2){var w=Math.max(40,rw+(e2.clientX-rx));th.style.width=w+'px';th.style.minWidth=w+'px';};\n      var up=function(){document.removeEventListener('mousemove',mv);document.removeEventListener('mouseup',up);};\n      document.addEventListener('mousemove',mv);document.addEventListener('mouseup',up);\n      e.stopPropagation();e.preventDefault();\n    });\n    th.appendChild(rh);\n  });\n})();\n\n// ── Chart: line/area for time-series, bar for everything else ─────────────\n\nwindow['sc_'+I]=function(){\n  var el=document.getElementById(I+'_ch');\n  if(!el.hidden){el.hidden=true;return;}\n  el.hidden=false;\n  var isTS=false;\n  var lc='order_id',vc='amount';\n  var cd=fil.slice(0,60);\n  var vs=cd.map(function(r){return Number(r[vc])||0;});\n  var mx=Math.max.apply(null,vs)||1;\n  var mn2=Math.min.apply(null,vs.filter(function(v){return v>0;}))||0;\n  var W=520,H=180,padL=60,padB=28,padT=16,iW=W-padL,iH=H-padB-padT;\n  if(isTS){\n    // ── Line / area chart ────────────────────────────────────────────────\n    var span=mx-mn2||1;\n    var pts=cd.map(function(r,i){\n      var x=padL+Math.round(i*(iW-1)/(Math.max(cd.length-1,1)));\n      var y=padT+Math.round(iH-(Number(r[vc])||0-mn2)/span*iH);\n      return x+','+y;\n    });\n    var areaPath='M'+padL+','+(padT+iH)+' L'+pts.join(' L')+' L'+(padL+iW)+','+(padT+iH)+' Z';\n    var dots=cd.map(function(r,i){\n      var x=padL+Math.round(i*(iW-1)/(Math.max(cd.length-1,1)));\n      var y=padT+Math.round(iH-(Number(r[vc])||0-mn2)/span*iH);\n      var lb=xe(String(r[lc]||'').slice(0,10));\n      var v2=(Number(r[vc])||0).toLocaleString();\n      return '<circle cx=\"'+x+'\" cy=\"'+y+'\" r=\"3\" fill=\"var(--vscode-charts-blue,#3794ff)\" opacity=\".9\">'+\n        '<title>'+lb+': '+v2+'</title></circle>';\n    }).join('');\n    // X axis labels (every Nth label to avoid crowding)\n    var step=Math.ceil(cd.length/8);\n    var xlabels=cd.filter(function(_,i){return i%step===0||i===cd.length-1;}).map(function(r,idx,arr){\n      var origIdx=idx===arr.length-1?cd.length-1:idx*step;\n      var x=padL+Math.round(origIdx*(iW-1)/(Math.max(cd.length-1,1)));\n      return '<text class=\"CV\" x=\"'+x+'\" y=\"'+(H-6)+'\" text-anchor=\"middle\">'+xe(String(r[lc]||'').slice(0,10))+'</text>';\n    }).join('');\n    el.innerHTML='<svg width=\"'+W+'\" height=\"'+H+'\" style=\"overflow:visible\">'+\n      '<defs><linearGradient id=\"ag'+I+'\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0%\" stop-color=\"var(--vscode-charts-blue,#3794ff)\" stop-opacity=\".25\"/><stop offset=\"100%\" stop-color=\"var(--vscode-charts-blue,#3794ff)\" stop-opacity=\".02\"/></linearGradient></defs>'+\n      '<path d=\"'+areaPath+'\" fill=\"url(#ag'+I+')\" />'+\n      '<polyline points=\"'+pts.join(' ')+'\" fill=\"none\" stroke=\"var(--vscode-charts-blue,#3794ff)\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>'+\n      dots+xlabels+\n      '<text class=\"CL\" x=\"'+(padL-8)+'\" y=\"'+(padT)+'\" text-anchor=\"end\">'+xe(vc)+'</text>'+\n      '<line x1=\"'+padL+'\" y1=\"'+padT+'\" x2=\"'+padL+'\" y2=\"'+(padT+iH)+'\" stroke=\"var(--vscode-panel-border)\" stroke-width=\"1\"/>'+\n      '<line x1=\"'+padL+'\" y1=\"'+(padT+iH)+'\" x2=\"'+(padL+iW)+'\" y2=\"'+(padT+iH)+'\" stroke=\"var(--vscode-panel-border)\" stroke-width=\"1\"/>'+\n      '</svg>';\n  } else {\n    // ── Bar chart ────────────────────────────────────────────────────────\n    var bw=Math.max(6,Math.floor(iW/Math.max(cd.length,1))-2);\n    var bars=cd.map(function(r,i){\n      var v2=Number(r[vc])||0;var bh=Math.max(1,Math.round((v2/mx)*iH));\n      var x=padL+i*(bw+2);var y=padT+iH-bh;\n      var lb=xe(String(r[lc]||'').slice(0,8));\n      return '<rect x=\"'+x+'\" y=\"'+y